"conversion.guide.button" = "Abrir la guía de compresión";
"conversion.guide.title" = "Guía de compresión";
"conversion.guide.hero.title" = "Comprime medios y ahorra espacio";
"conversion.guide.hero.detail" = "Comprime imágenes, vídeo y audio localmente en este dispositivo sin cambiar los originales.";
"conversion.guide.steps.title" = "Inicio rápido";
"conversion.guide.step.choose.title" = "Elige un tipo de medio";
"conversion.guide.step.choose.detail" = "Importa imágenes y vídeos desde Fotos o Archivos. La herramienta Audio acepta archivos de audio o vídeo desde Archivos.";
"conversion.guide.step.adjust.title" = "Ajusta la compresión";
"conversion.guide.step.adjust.detail" = "Elige un formato y ajusta la calidad, resolución, tasa de bits o metadatos según necesites.";
"conversion.guide.step.convert.title" = "Comprime y comparte";
"conversion.guide.step.convert.detail" = "Sigue el progreso de compresión, revisa el resultado y compártelo donde lo necesites.";
"conversion.guide.home.title" = "Empieza con el archivo que quieres reducir";
"conversion.guide.home.detail" = "Cada herramienta funciona por separado para llevarte directamente a la tarea que necesitas.";
"conversion.guide.tools.title" = "Tres herramientas de compresión multimedia";
"conversion.guide.image.detail" = "Comprime imágenes, ajusta el formato y el tamaño, y elimina la ubicación antes de compartir.";
"conversion.guide.video.detail" = "Comprime vídeo eligiendo contenedor, códec y resolución. La compatibilidad final depende del dispositivo y del vídeo de origen.";
"conversion.guide.audio.detail" = "Comprime audio o selecciona aquí un vídeo para extraer y comprimir su pista de audio.";
"conversion.guide.controls.title" = "Ajusta la compresión";
"conversion.guide.format.detail" = "Elige un formato que equilibre compatibilidad, calidad y tamaño según el uso del archivo.";
"conversion.guide.quality.detail" = "Usa la calidad de imagen, el códec y la resolución de vídeo o la tasa AAC para reducir el tamaño. Los formatos de audio sin pérdida conservan la calidad, pero no siempre reducen el tamaño.";
"conversion.guide.metadata.detail" = "Conserva los metadatos que se puedan escribir, elimina solo el GPS o elimínalos todos. El valor predeterminado elimina solo el GPS.";
"conversion.guide.privacy.title" = "Tus originales siguen siendo tuyos";
"conversion.guide.privacy.detail" = "Todo se procesa en este dispositivo. «Borrar todo» elimina solo las copias y los archivos de salida gestionados por la app, nunca los originales de Fotos o Archivos.";
"conversion.guide.learn_more" = "Ver detalles";
"conversion.guide.quality.title" = "Calidad y tamaño";
"conversion.guide.detail.purpose.title" = "Para qué sirve";
"conversion.guide.detail.workflow.title" = "Lotes, progreso y resultados";
"conversion.guide.output.detail" = "La carpeta de salida la gestiona la app y solo se muestra su ubicación. Usa Compartir para mover un resultado a otro lugar.";
"conversion.guide.image.purpose" = "Comprime imágenes estáticas por lotes y controla el formato, la calidad, el lado más largo y los metadatos. Los ajustes se aplican al lote actual sin modificar los originales.";
"conversion.guide.image.imports.detail" = "Selecciona varios archivos o hasta 100 elementos de Fotos. Los formatos dependen de las capacidades de este dispositivo; RAW, DNG y ProRAW solo se pueden importar y no se admiten imágenes animadas.";
"conversion.guide.image.workflow.detail" = "Consulta los estados de lectura y compresión, o cancela durante el proceso; los resultados completados se conservan. Compara los tamaños y comparte desde cada tarjeta antes de borrar la lista.";
"conversion.guide.image.quality.detail" = "JPEG, HEIC, HEIF y WebP permiten ajustar la calidad del 10 % al 100 % en pasos del 5 %, con un 85 % predeterminado. Una calidad menor suele crear archivos más pequeños con una pérdida más visible; los demás formatos no tienen control de calidad.";
"resize.square1024" = "1024px";
"conversion.guide.image.resize.detail" = "Conserva las dimensiones originales o limita el lado más largo a 4096, 2048 o 1280 px para reducir el tamaño sin ampliar. La opción 1024 × 1024 centra la imagen completa sobre un fondo cuadrado con márgenes, sin recortar ni deformar; las imágenes pequeñas se amplían.";
"conversion.guide.image.transparency.detail" = "JPEG y BMP no pueden guardar píxeles transparentes. Al usar estos formatos, rellena las zonas transparentes de blanco o negro.";
"conversion.guide.video.purpose" = "Comprime por lotes vídeos MOV, MP4 o M4V eligiendo contenedor, códec y resolución, sin sobrescribir los originales.";
"conversion.guide.video.imports.detail" = "Selecciona varios archivos MOV, MP4 o M4V, o hasta 50 vídeos desde Fotos.";
"conversion.guide.video.workflow.detail" = "Los vídeos se procesan uno a uno. Consulta el estado y el número completado, cancela cuando lo necesites y después compara tamaños y comparte cada resultado.";
"conversion.guide.video.resolution.detail" = "Reducir la resolución suele reducir el tamaño del archivo. H.264 ofrece Original, 4K, 1080p, 720p y 480p; HEVC ofrece Original, 4K y 1080p; ProRes conserva la resolución original.";
"conversion.guide.video.compatibility.title" = "Combinaciones y compatibilidad";
"conversion.guide.video.compatibility.detail" = "Las opciones de contenedor y resolución se reducen según el códec. La compatibilidad final también depende del dispositivo y del vídeo de origen.";
"conversion.guide.video.codec.h264.detail" = "La compatibilidad más amplia: MP4, MOV o M4V, con todas las resoluciones disponibles.";
"conversion.guide.video.codec.hevc.detail" = "Compresión más eficiente en dispositivos modernos: MP4 o MOV en Original, 4K o 1080p. La compatibilidad puede ser menor en dispositivos y apps antiguos.";
"conversion.guide.video.codec.prores422.detail" = "Códec de alta calidad para edición: solo MOV, con resolución original; los archivos suelen ser grandes y no están pensados para ahorrar espacio.";
"conversion.guide.video.codec.prores4444.detail" = "Códec de alta calidad para posproducción exigente: solo MOV, con resolución original; los archivos suelen ser muy grandes y no están pensados para ahorrar espacio.";
"conversion.guide.audio.purpose" = "Comprime audio compatible o crea un archivo de audio comprimido independiente a partir de un vídeo con una pista legible. Los originales no se modifican.";
"conversion.guide.audio.imports.detail" = "Selecciona varios elementos solo desde Archivos. Audio: M4A, AAC, MP3, WAV, AIFF/AIF, CAF. Vídeo: MOV, MP4, M4V. MP3 solo se puede importar.";
"conversion.guide.audio.workflow.detail" = "Consulta el tipo de origen, la duración, el estado y el número completado, o cancela cuando lo necesites. Compara tamaños y comparte el audio terminado.";
"conversion.guide.audio.quality.detail" = "La salida AAC ofrece 96, 128, 192 o 256 kbps, con 192 kbps como valor predeterminado. Una tasa menor suele crear archivos más pequeños con una pérdida más audible; una tasa mayor suele conservar más detalles.";
"conversion.guide.audio.lossless.title" = "Formatos sin pérdida";
"conversion.guide.audio.lossless.detail" = "M4A (ALAC), WAV, AIFF, CAF PCM y CAF ALAC no usan el ajuste de tasa de bits. Conservan la calidad de audio disponible, por lo que no siempre reducen el tamaño.";
"conversion.guide.audio.extract.title" = "Extraer de un vídeo";
"conversion.guide.audio.extract.detail" = "Elige un archivo MOV, MP4 o M4V en Archivos para leer su pista de audio disponible y volver a codificarla en el formato elegido. El vídeo no cambia; los vídeos protegidos o sin audio no se pueden extraer.";
"settings.background" = "Fondo";
"color.transparent" = "Transparente";
"settings.background.detail" = "Se aplica a los píxeles transparentes y los márgenes cuadrados; no elimina el fondo de la imagen. La transparencia está disponible en PNG y TIFF. Los demás formatos restablecen el blanco.";
