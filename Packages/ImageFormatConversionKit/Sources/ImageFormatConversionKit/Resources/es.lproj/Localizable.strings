"conversion.guide.image.detail" = "JPG, PNG, HEIC y más. Ajusta calidad y dimensiones.";
"conversion.guide.video.detail" = "MP4, MOV, M4V. Elige códec, tasa de bits y resolución.";
"conversion.guide.audio.detail" = "MP3, AAC, WAV y más. Ajusta la tasa de bits o extrae audio de un vídeo.";
"conversion.guide.controls.title" = "Ajusta la conversión";
"conversion.guide.format.detail" = "Elige un formato que equilibre compatibilidad, calidad y tamaño según el uso del archivo.";
"conversion.guide.quality.detail" = "Una calidad o tasa de bits menor suele reducir el tamaño. El resultado depende del contenido; los formatos sin pérdida pueden no reducirlo.";
"conversion.guide.metadata.detail" = "Conserva los metadatos que se puedan escribir, elimina solo el GPS o elimínalos todos. El valor predeterminado elimina solo el GPS.";
"conversion.guide.replace.title" = "Reemplazar originales";
"conversion.guide.replace.detail" = "Después de convertir, toca la papelera en la pantalla principal y selecciona colecciones de imágenes o vídeos. La app guarda primero las copias convertidas en Fotos y después iOS te pide confirmar que se eliminen los originales correspondientes. Solo se admiten elementos completados importados desde Fotos; el audio independiente y las importaciones desde Archivos no son compatibles. Borrar todo elimina únicamente las copias de trabajo y desactiva el reemplazo, pero nunca borra originales.";
"conversion.guide.privacy.title" = "Tus originales siguen siendo tuyos";
"conversion.guide.privacy.detail" = "Todo se procesa en este dispositivo. «Borrar todo» elimina solo las copias y los archivos de salida gestionados por la app, nunca los originales de Fotos o Archivos.";
"conversion.guide.learn_more" = "Ver detalles";
"conversion.guide.quality.title" = "Calidad y tamaño";
"conversion.guide.detail.purpose.title" = "Para qué sirve";
"conversion.guide.detail.workflow.title" = "Lotes, progreso y resultados";
"conversion.guide.output.detail" = "La carpeta de salida la gestiona la app y solo se muestra su ubicación. Usa Compartir para mover un resultado a otro lugar.";
"conversion.guide.image.purpose" = "JPG, PNG, HEIC y más. Ajusta calidad y dimensiones.";
"conversion.guide.image.imports.detail" = "Selecciona varios archivos o hasta 100 elementos de Fotos. Los formatos dependen de las capacidades de este dispositivo; RAW, DNG y ProRAW solo se pueden importar y no se admiten imágenes animadas.";
"conversion.guide.image.workflow.detail" = "Consulta los estados de lectura y conversión, o cancela durante el proceso; los resultados completados se conservan. Compara los tamaños y comparte desde cada tarjeta antes de borrar la lista.";
"conversion.guide.image.quality.detail" = "JPG, PNG, HEIC y más. Ajusta calidad y dimensiones. Una calidad o tasa de bits menor suele reducir el tamaño. El resultado depende del contenido; los formatos sin pérdida pueden no reducirlo.";
"resize.square1024" = "1024px";
"conversion.guide.image.resize.detail" = "Conserva las dimensiones originales o limita el lado más largo a 4096, 2048 o 1280 px para reducir el tamaño sin ampliar. La opción 1024 × 1024 centra la imagen completa sobre un fondo cuadrado con márgenes, sin recortar ni deformar; las imágenes pequeñas se amplían.";
"conversion.guide.image.transparency.detail" = "JPG y BMP no pueden guardar píxeles transparentes. Al usar estos formatos, rellena las zonas transparentes de blanco o negro.";
"conversion.guide.video.purpose" = "MP4, MOV, M4V. Elige códec, tasa de bits y resolución.";
"conversion.guide.video.imports.detail" = "Selecciona varios archivos MOV, MP4 o M4V, o hasta 50 vídeos desde Fotos.";
"conversion.guide.video.workflow.detail" = "Los vídeos se procesan uno a uno. Consulta el estado y el número completado, cancela cuando lo necesites y después compara tamaños y comparte cada resultado.";
"conversion.guide.video.resolution.detail" = "Reducir la resolución suele reducir el tamaño del archivo. H.264 ofrece Original, 4K, 1080p, 720p y 480p; HEVC ofrece Original, 4K y 1080p; ProRes conserva la resolución original.";
"conversion.guide.video.compatibility.title" = "Combinaciones y compatibilidad";
"conversion.guide.video.compatibility.detail" = "Las opciones de contenedor y resolución se reducen según el códec. La compatibilidad final también depende del dispositivo y del vídeo de origen.";
"conversion.guide.video.codec.h264.detail" = "La compatibilidad más amplia: MP4, MOV o M4V, con todas las resoluciones disponibles.";
"conversion.guide.video.codec.hevc.detail" = "Conversión más eficiente en dispositivos modernos: MP4 o MOV en Original, 4K o 1080p. La compatibilidad puede ser menor en dispositivos y apps antiguos.";
"conversion.guide.video.codec.prores422.detail" = "Códec de alta calidad para edición: solo MOV, con resolución original; los archivos suelen ser grandes y no están pensados para ahorrar espacio.";
"conversion.guide.video.codec.prores4444.detail" = "Códec de alta calidad para posproducción exigente: solo MOV, con resolución original; los archivos suelen ser muy grandes y no están pensados para ahorrar espacio.";
"conversion.guide.audio.purpose" = "MP3, AAC, WAV y más. Ajusta la tasa de bits o extrae audio de un vídeo.";
"conversion.guide.audio.imports.detail" = "Selecciona audio o vídeo desde Archivos, o vídeos desde Fotos para extraer sus pistas de audio. Entradas de audio: M4A (incluido ALAC), AAC, MP3, FLAC, WAV, AIFF/AIF y CAF. Entradas de vídeo: MOV, MP4 y M4V.";
"conversion.guide.audio.workflow.detail" = "Consulta el tipo de origen, la duración, el estado y el número completado, o cancela cuando lo necesites. Compara tamaños y comparte el audio terminado.";
"conversion.guide.audio.quality.detail" = "MP3 y AAC ofrecen 96, 128, 192, 256 o 320 kbps; el valor predeterminado es 192 kbps. ALAC, WAV, AIFF y PCM CAF son formatos sin pérdida y no usan un ajuste de tasa de bits.";
"conversion.guide.audio.m4a.title" = "M4A: contenedor y códec";
"conversion.guide.audio.m4a.detail" = "M4A es el contenedor del archivo, no el método de conversión. M4A (AAC) usa conversión con pérdida para archivos más pequeños y fáciles de compartir; M4A (Apple Lossless/ALAC) conserva la calidad disponible, pero suele ocupar más. Elige AAC para uso diario o ALAC cuando importe evitar una pérdida adicional.";
"conversion.guide.audio.lossless.title" = "Formatos sin pérdida";
"conversion.guide.audio.lossless.detail" = "M4A (ALAC) y CAF ALAC usan conversión sin pérdida; WAV, AIFF y CAF PCM guardan audio sin convertir y suelen ocupar más. Conservan la calidad disponible, pero convertir MP3 o AAC a un formato sin pérdida no recupera los detalles ya eliminados.";
"conversion.guide.audio.extract.title" = "Extraer de un vídeo";
"conversion.guide.audio.extract.detail" = "Elige MOV, MP4 o M4V en Archivos o Fotos para recodificar su pista de audio disponible en el formato elegido. El vídeo no cambia; los vídeos protegidos o sin audio no se pueden extraer.";
