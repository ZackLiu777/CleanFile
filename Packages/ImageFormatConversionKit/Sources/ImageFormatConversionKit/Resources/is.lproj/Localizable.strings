"conversion.guide.button" = "Opnaðu þjöppunarleiðbeiningar";
"conversion.guide.title" = "Þjöppunarleiðbeiningar";
"conversion.guide.hero.title" = "Compress media, save space";
"conversion.guide.hero.detail" = "Þjappaðu myndum, myndböndum og hljóði á staðnum á þessu tæki án þess að breyta upprunalegum myndum.";
"conversion.guide.steps.title" = "Fljótleg byrjun";
"conversion.guide.step.choose.title" = "Veldu miðlunartegund";
"conversion.guide.step.choose.detail" = "Flytja inn myndir og myndskeið úr myndum eða skrám. Hljóðtólið tekur við hljóði eða myndskeiði frá skrám.";
"conversion.guide.step.adjust.title" = "Stilltu þjöppun";
"conversion.guide.step.adjust.detail" = "Veldu snið og stilltu gæði, upplausn, bitahraða eða lýsigögn eftir þörfum.";
"conversion.guide.step.convert.title" = "Compress and share";
"conversion.guide.step.convert.detail" = "Fylgstu með framvindu þjöppunar, skoðaðu niðurstöðuna og deildu henni síðan hvar sem þú þarft.";
"conversion.guide.home.title" = "Byrjaðu á skránni sem þú vilt minnka";
"conversion.guide.home.detail" = "Hvert verkfæri stendur fyrir sínu, svo þú getur farið beint í það verk sem þú þarft.";
"conversion.guide.tools.title" = "Þrjú fjölmiðlaþjöppunartæki";
"conversion.guide.image.detail" = "Compress images, adjust the output format and size, and remove location metadata before sharing.";
"conversion.guide.video.detail" = "Þjappaðu myndbandi með því að velja ílát, merkjamál og upplausn. Final support depends on the device and source.";
"conversion.guide.audio.detail" = "Compress audio files—or select a video here to extract and compress its audio track.";
"conversion.guide.controls.title" = "Mótaðu þjöppunina";
"conversion.guide.format.detail" = "Veldu snið sem kemur jafnvægi á eindrægni, gæði og skráarstærð fyrir hvernig skráin verður notuð.";
"conversion.guide.quality.detail" = "Notaðu myndgæði, myndkóða og upplausn, eða AAC bitahraða til að minnka stærðina. Taplaus hljóðsnið varðveita gæði en gæti ekki minnkað stærðina.";
"conversion.guide.metadata.detail" = "Geymdu öll skrifanleg lýsigögn, fjarlægðu aðeins GPS eða fjarlægðu allt. GPS fjarlæging er sjálfgefið.";
"conversion.guide.replace.title" = "Skipta út frumritum";
"conversion.guide.replace.detail" = "Eftir þjöppun skaltu ýta á ruslafötuna á heimaskjánum og velja mynda- eða myndbandasöfn. Forritið vistar fyrst þjöppuð afrit í Myndir og síðan biður iOS um staðfestingu á eyðingu samsvarandi frumrita. Aðeins lokin atriði sem flutt voru inn úr Myndum eru studd; sjálfstætt hljóð og innflutningur úr Skrám eru ekki studd. Hreinsa allt fjarlægir aðeins vinnuafrit og gerir útskiptingu óvirka, en eyðir aldrei frumritum.";
"conversion.guide.privacy.title" = "Your originals stay yours";
"conversion.guide.privacy.detail" = "Allt er unnið á þessu tæki. Hreinsa allt fjarlægir aðeins forritstýrð afrit og úttak, aldrei frumritin þín í myndum eða skrám.";
"conversion.guide.learn_more" = "Skoðaðu þetta tól";
"conversion.guide.quality.title" = "Gæði og stærð";
"conversion.guide.detail.purpose.title" = "Til hvers það er";
"conversion.guide.detail.workflow.title" = "Hópur, framfarir og árangur";
"conversion.guide.output.detail" = "Úttaksmappa sem er stjórnað af forritum er sýnd í tólinu en er ekki hægt að velja. Notaðu Share til að færa niðurstöðu eitthvert annað.";
"conversion.guide.image.purpose" = "Hópþjappaðu kyrrstæðum myndum eftir sniði, gæðum, lengstu brún og lýsigögnum. Eitt sett af valkostum á við um núverandi lotu án þess að breyta frumritunum.";
"conversion.guide.image.imports.detail" = "Veldu margar skrár, eða allt að 100 atriði úr myndum. Snið endurspegla getu þessa tækis; RAW/DNG/ProRAW eru eingöngu til innflutnings og hreyfimyndir eru ekki studdar.";
"conversion.guide.image.workflow.detail" = "Fylgdu skoðunar- og þjöppunarstöðu, eða hættu við á meðan vinna er í gangi; kláruð úrslit standa eftir. Berðu saman stærðir og deildu af hverju skráarspjaldi áður en þú hreinsar listann.";
"conversion.guide.image.quality.detail" = "JPG, HEIC, HEIF og WebP styðja 10%–100% gæði í 5% skrefum, með 85% sem sjálfgefið. Minni gæði skapa venjulega smærri skrár með meira sýnilegt tap; önnur snið sýna ekki gæðaeftirlit.";
"resize.square1024" = "1024px";
"conversion.guide.image.resize.detail" = "Haltu upprunalegu málunum eða settu yfir lengstu brúnina í 4096, 2048 eða 1280 px til að minnka stærðina án þess að stækka. 1024 × 1024 valkosturinn passar alla myndina á ferkantaðan bakgrunn án þess að skera eða teygja; litlar myndir eru stækkaðar.";
"conversion.guide.image.transparency.detail" = "JPG og BMP geta ekki geymt gagnsæja pixla. Þegar annað hvort snið er notað skaltu fylla gegnsæ svæði með hvítu eða svörtu.";
"conversion.guide.video.purpose" = "Hópþjappaðu MOV, MP4 eða M4V myndskeið eftir íláti, merkjamáli og upplausn án þess að skrifa yfir frumritin.";
"conversion.guide.video.imports.detail" = "Veldu margar MOV, MP4 eða M4V skrár, eða veldu allt að 50 myndbönd úr myndum.";
"conversion.guide.video.workflow.detail" = "Videos are processed one by one. Fylgdu verkefnastöðu og talningu lokið, hættu við þegar þörf krefur, berðu síðan saman inntaks- og úttakstærðir og deildu hverri niðurstöðu.";
"conversion.guide.video.resolution.detail" = "Að lækka upplausn dregur venjulega úr skráarstærð. H.264 býður upp á Original, 4K, 1080p, 720p og 480p; HEVC býður upp á Original, 4K og 1080p; ProRes heldur upprunalegu upplausninni.";
"conversion.guide.video.compatibility.title" = "Samsetningar og stuðningur við tæki";
"conversion.guide.video.compatibility.detail" = "Gáma- og upplausnarval minnkar eftir að þú hefur valið merkjamál. Tækið og upprunamyndbandið fá samt lokaathugun á samhæfi.";
"conversion.guide.video.codec.h264.detail" = "Víðtækasta samhæfni: MP4, MOV eða M4V; Upprunalegt, 4K, 1080p, 720p eða 480p.";
"conversion.guide.video.codec.hevc.detail" = "Skilvirkari þjöppun: MP4 eða MOV; Upprunalegt, 4K eða 1080p. Eldri tæki og öpp gætu verið minna samhæf.";
"conversion.guide.video.codec.prores422.detail" = "Fyrir hágæða klippingu: MOV eingöngu, í upprunalegri upplausn. Skrár eru venjulega stórar og eru ekki ætlaðar til plásssparandi þjöppunar.";
"conversion.guide.video.codec.prores4444.detail" = "Fyrir hágæða eftirvinnslu: Aðeins MOV, í upprunalegri upplausn. Skrár eru yfirleitt mjög stórar og eru ekki ætlaðar til plásssparandi þjöppunar.";
"conversion.guide.audio.purpose" = "Compress audio or create a separate compressed audio file from a video with a usable track. The original audio and video remain unchanged.";
"conversion.guide.audio.imports.detail" = "Veldu hljóð eða myndskeið úr skrám, eða veldu myndbönd úr myndum til að draga út hljóðrásir þeirra. Hljóðinntak: M4A (þar á meðal ALAC), AAC, MP3, FLAC, WAV, AIFF/AIF og CAF. Vídeóinntak: MOV, MP4 og M4V.";
"conversion.guide.audio.workflow.detail" = "Fylgdu upprunategund, tímalengd, verkefnastöðu og talningu lokið, eða hættu við þegar þörf krefur. Berðu saman inntaks- og úttakstærðir og deildu fullbúnu hljóði.";
"conversion.guide.audio.quality.detail" = "MP3 og AAC bjóða upp á 96, 128, 192, 256 eða 320 kbps; sjálfgefið er 192 kbps. ALAC, WAV, AIFF og PCM CAF eru taplaus og nota ekki bitahraða stillingu.";
"conversion.guide.audio.m4a.title" = "M4A: gámur og merkjamál";
"conversion.guide.audio.m4a.detail" = "M4A er skráarílátið, ekki þjöppunaraðferðin. M4A (AAC) notar tapaða þjöppun fyrir smærri skrár sem hægt er að deila; M4A (Apple Lossless/ALAC) varðveitir tiltæk gæði upprunans en er venjulega stærri. Veldu AAC fyrir daglega geymslu og samnýtingu, eða ALAC þegar þú forðast frekara gæðatap skiptir meira máli en stærð.";
"conversion.guide.audio.lossless.title" = "Taplaus snið";
"conversion.guide.audio.lossless.detail" = "M4A (ALAC) og CAF ALAC nota taplausa þjöppun; WAV, AIFF og CAF PCM geyma óþjappað hljóð og eru venjulega stærri. Þessi snið varðveita gæðin sem eru tiltæk í upprunanum og nota ekki bitahraðastillingu. Að breyta MP3 eða AAC í tapslaust getur ekki endurheimt smáatriði sem þegar hafa verið fjarlægð með tapsþjöppun.";
"conversion.guide.audio.extract.title" = "Útdráttur úr myndbandi";
