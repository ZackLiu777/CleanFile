"color.transparent" = "Transparent";
"settings.background.detail" = "Gilt für transparente Pixel und quadratische Auffüllung; Der Bildhintergrund wird nicht entfernt. Transparenz ist für PNG und TIFF verfügbar. Bei anderen Formaten wird die Transparenz auf Weiß zurückgesetzt.";
