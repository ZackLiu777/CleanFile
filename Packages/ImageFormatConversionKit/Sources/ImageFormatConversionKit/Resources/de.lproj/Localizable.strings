"conversion.guide.title" = "Kompressionsanleitung";
"conversion.guide.hero.title" = "Medien komprimieren, Platz sparen";
"conversion.guide.hero.detail" = "Komprimieren Sie Bilder, Videos und Audio lokal auf diesem Gerät, ohne die Originale zu verändern.";
"conversion.guide.steps.title" = "Schnellstart";
"conversion.guide.step.choose.title" = "Wählen Sie einen Medientyp";
"conversion.guide.step.choose.detail" = "Importieren Sie Bilder und Videos aus Fotos oder Dateien. Das Audio-Tool akzeptiert Audio- oder Videodateien aus Dateien.";
"conversion.guide.step.adjust.title" = "Komprimierung anpassen";
"conversion.guide.step.adjust.detail" = "Wählen Sie ein Format und passen Sie Qualität, Auflösung, Bitrate oder Metadaten nach Bedarf an.";
"conversion.guide.step.convert.title" = "Komprimieren und teilen";
"conversion.guide.step.convert.detail" = "Verfolgen Sie den Komprimierungsfortschritt, überprüfen Sie das Ergebnis und teilen Sie es dann, wo immer Sie es benötigen.";
"conversion.guide.home.title" = "Beginnen Sie mit der Datei, die Sie verkleinern möchten";
"conversion.guide.home.detail" = "Jedes Werkzeug steht für sich allein, sodass Sie direkt mit der Arbeit beginnen können, die Sie benötigen.";
"conversion.guide.tools.title" = "Drei Tools zur Medienkomprimierung";
"conversion.guide.image.detail" = "Komprimieren Sie Bilder, passen Sie das Ausgabeformat und die Ausgabegröße an und entfernen Sie Standortmetadaten, bevor Sie sie teilen.";
"conversion.guide.video.detail" = "Komprimieren Sie Videos, indem Sie einen Container, einen Codec und eine Auflösung auswählen. Die endgültige Unterstützung hängt vom Gerät und der Quelle ab.";
"conversion.guide.audio.detail" = "Komprimieren Sie Audiodateien – oder wählen Sie hier ein Video aus, um dessen Audiospur zu extrahieren und zu komprimieren.";
"conversion.guide.controls.title" = "Gestalten Sie die Kompression";
"conversion.guide.format.detail" = "Wählen Sie ein Format, das Kompatibilität, Qualität und Dateigröße für die Verwendung der Datei in Einklang bringt.";
"conversion.guide.quality.detail" = "Verwenden Sie Bildqualität, Videocodec und -auflösung oder AAC-Bitrate, um die Größe zu reduzieren. Verlustfreie Audioformate bewahren die Qualität, verringern jedoch möglicherweise nicht die Größe.";
"conversion.guide.metadata.detail" = "Behalten Sie alle beschreibbaren Metadaten bei, entfernen Sie nur GPS oder entfernen Sie alles. Die GPS-Entfernung ist die Standardeinstellung.";
"conversion.guide.replace.title" = "Originale ersetzen";
"conversion.guide.replace.detail" = "Tippen Sie nach der Komprimierung auf der Startseite auf den Papierkorb und wählen Sie Bild- oder Videosammlungen. Die App speichert zuerst die komprimierten Kopien in Fotos; anschließend bittet iOS um Bestätigung zum Löschen der Originale. Verfügbar ist dies nur für abgeschlossene Importe aus Fotos, nicht für einzelne Audiodateien oder Importe aus Dateien. Alle löschen entfernt nur Arbeitskopien und deaktiviert das Ersetzen, löscht aber keine Originale.";
"conversion.guide.privacy.title" = "Ihre Originale bleiben Ihr Eigentum";
"conversion.guide.privacy.detail" = "Alles wird auf diesem Gerät verarbeitet. „Alle löschen“ entfernt nur von der App verwaltete Kopien und Ausgaben, niemals Ihre Originale in Fotos oder Dateien.";
"conversion.guide.learn_more" = "Entdecken Sie dieses Tool";
"conversion.guide.quality.title" = "Qualität und Größe";
"conversion.guide.detail.purpose.title" = "Wofür es ist";
"conversion.guide.detail.workflow.title" = "Charge, Fortschritt und Ergebnisse";
"conversion.guide.output.detail" = "Der von der App verwaltete Ausgabeordner wird im Tool angezeigt, kann jedoch nicht ausgewählt werden. Verwenden Sie „Teilen“, um ein Ergebnis an eine andere Stelle zu verschieben.";
"conversion.guide.image.purpose" = "Komprimieren Sie statische Bilder stapelweise nach Format, Qualität, längster Kante und Metadaten. Ein Satz Optionen gilt für den aktuellen Stapel, ohne dass die Originale geändert werden.";
"conversion.guide.image.imports.detail" = "Wählen Sie mehrere Dateien oder bis zu 100 Elemente aus Fotos aus. Formate spiegeln die Fähigkeiten dieses Geräts wider; RAW/DNG/ProRAW sind nur importierbar und animierte Bilder werden nicht unterstützt.";
"conversion.guide.image.workflow.detail" = "Befolgen Sie die Inspektions- und Komprimierungszustände oder brechen Sie den Vorgang ab, während die Arbeit ausgeführt wird. abgeschlossene Ergebnisse bleiben erhalten. Vergleichen Sie die Größen und teilen Sie sie auf jeder Karteikarte, bevor Sie die Liste löschen.";
"conversion.guide.image.quality.detail" = "JPG, HEIC, HEIF und WebP unterstützen eine Qualität von 10 % bis 100 % in 5 %-Schritten, wobei 85 % die Standardeinstellung ist. Eine geringere Qualität führt normalerweise zu kleineren Dateien mit stärker sichtbarem Verlust; Bei anderen Formaten erfolgt keine Qualitätskontrolle.";
"resize.square1024" = "1024px";
"conversion.guide.image.resize.detail" = "Behalten Sie die ursprünglichen Abmessungen bei oder begrenzen Sie die längste Kante auf 4096, 2048 oder 1280 Pixel, um die Größe zu reduzieren, ohne sie zu vergrößern. Die Option 1024 × 1024 passt das gesamte Bild ohne Zuschneiden oder Strecken auf einen quadratischen Hintergrund. kleine Bilder werden vergrößert.";
"conversion.guide.image.transparency.detail" = "JPG und BMP können keine transparenten Pixel speichern. Wenn Sie eines der beiden Formate verwenden, füllen Sie transparente Bereiche mit Weiß oder Schwarz.";
"conversion.guide.video.purpose" = "Komprimieren Sie MOV-, MP4- oder M4V-Videos stapelweise nach Container, Codec und Auflösung, ohne die Originale zu überschreiben.";
"conversion.guide.video.imports.detail" = "Wählen Sie mehrere MOV-, MP4- oder M4V-Dateien aus oder wählen Sie bis zu 50 Videos aus Fotos aus.";
"conversion.guide.video.workflow.detail" = "Videos werden einzeln verarbeitet. Verfolgen Sie den Aufgabenstatus und die Anzahl der abgeschlossenen Aufgaben, brechen Sie sie bei Bedarf ab, vergleichen Sie dann die Eingabe- und Ausgabegrößen und teilen Sie jedes Ergebnis.";
"conversion.guide.video.resolution.detail" = "Eine Verringerung der Auflösung verringert normalerweise die Dateigröße. H.264 bietet Original, 4K, 1080p, 720p und 480p; HEVC bietet Original, 4K und 1080p; ProRes behält die ursprüngliche Auflösung bei.";
"conversion.guide.video.compatibility.title" = "Kombinationen und Geräteunterstützung";
"conversion.guide.video.compatibility.detail" = "Die Auswahlmöglichkeiten für Container und Auflösung werden eingeschränkt, nachdem Sie einen Codec ausgewählt haben. Das Gerät und das Quellvideo werden noch einer abschließenden Kompatibilitätsprüfung unterzogen.";
"conversion.guide.video.codec.h264.detail" = "Größte Kompatibilität: MP4, MOV oder M4V; Original, 4K, 1080p, 720p oder 480p.";
"conversion.guide.video.codec.hevc.detail" = "Effizientere Komprimierung: MP4 oder MOV; Original, 4K oder 1080p. Ältere Geräte und Apps sind möglicherweise weniger kompatibel.";
"conversion.guide.video.codec.prores422.detail" = "Für hochwertige Bearbeitung: Nur MOV, in der Originalauflösung. Dateien sind in der Regel groß und nicht für eine platzsparende Komprimierung gedacht.";
"conversion.guide.video.codec.prores4444.detail" = "Für hochwertige Postproduktion: Nur MOV, in der Originalauflösung. Dateien sind in der Regel sehr groß und nicht für eine platzsparende Komprimierung gedacht.";
"conversion.guide.audio.purpose" = "Komprimieren Sie Audio oder erstellen Sie eine separate komprimierte Audiodatei aus einem Video mit einer verwendbaren Spur. Das Original-Audio und -Video bleibt unverändert.";
"conversion.guide.audio.imports.detail" = "Wählen Sie Audio oder Video aus Dateien oder Videos aus Fotos aus, um deren Audiospuren zu extrahieren. Audioeingänge: M4A (einschließlich ALAC), AAC, MP3, FLAC, WAV, AIFF/AIF und CAF. Videoeingänge: MOV, MP4 und M4V.";
"conversion.guide.audio.workflow.detail" = "Befolgen Sie den Quelltyp, die Dauer, den Aufgabenstatus und die Anzahl der abgeschlossenen Aufgaben oder brechen Sie bei Bedarf ab. Vergleichen Sie Eingabe- und Ausgabegrößen und teilen Sie das fertige Audio.";
"conversion.guide.audio.quality.detail" = "MP3 und AAC bieten 96, 128, 192, 256 oder 320 kbps; Der Standardwert ist 192 kbit/s. ALAC, WAV, AIFF und PCM CAF sind verlustfrei und verwenden keine Bitrateneinstellung.";
"conversion.guide.audio.m4a.title" = "M4A: Container und Codec";
"conversion.guide.audio.m4a.detail" = "M4A ist der Dateicontainer, nicht die Komprimierungsmethode. M4A (AAC) verwendet verlustbehaftete Komprimierung für kleinere, gemeinsam nutzbare Dateien; M4A (Apple Lossless/ALAC) behält die verfügbare Qualität der Quelle bei, ist aber normalerweise größer. Wählen Sie AAC für die tägliche Speicherung und gemeinsame Nutzung oder ALAC, wenn die Vermeidung weiterer Qualitätsverluste wichtiger ist als die Größe.";
"conversion.guide.audio.lossless.title" = "Verlustfreie Formate";
"conversion.guide.audio.lossless.detail" = "M4A (ALAC) und CAF ALAC verwenden verlustfreie Komprimierung; WAV, AIFF und CAF PCM speichern unkomprimiertes Audio und sind normalerweise größer. Diese Formate bewahren die in der Quelle verfügbare Qualität und verwenden keine Bitrateneinstellung. Durch die Konvertierung von MP3 oder AAC in eine verlustfreie Datei können Details, die bereits durch verlustbehaftete Komprimierung entfernt wurden, nicht wiederhergestellt werden.";
"conversion.guide.audio.extract.title" = "Auszug aus Video";
"conversion.guide.audio.extract.detail" = "Wählen Sie MOV, MP4 oder M4V aus „Dateien“ oder „Fotos“, um die verfügbare Audiospur zu lesen und sie im ausgewählten Format neu zu kodieren. Das Video wird nicht verändert; Geschützte Videos oder Videos ohne Audio können nicht extrahiert werden.";
