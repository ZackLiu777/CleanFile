"conversion.guide.title" = "Kompressionsguide";
"conversion.guide.hero.title" = "Komprimera media, spara utrymme";
"conversion.guide.hero.detail" = "Komprimera bilder, video och ljud lokalt på den här enheten utan att ändra originalen.";
"conversion.guide.steps.title" = "Snabbstart";
"conversion.guide.step.choose.title" = "Välj en mediatyp";
"conversion.guide.step.choose.detail" = "Importera bilder och video från foton eller filer. Ljudverktyget accepterar ljud eller video från filer.";
"conversion.guide.step.adjust.title" = "Justera kompressionen";
"conversion.guide.step.adjust.detail" = "Välj ett format och justera kvalitet, upplösning, bithastighet eller metadata efter behov.";
"conversion.guide.step.convert.title" = "Komprimera och dela";
"conversion.guide.step.convert.detail" = "Följ komprimeringsförloppet, granska resultatet och dela det sedan var du behöver.";
"conversion.guide.home.title" = "Börja med filen du vill krympa";
"conversion.guide.home.detail" = "Varje verktyg står för sig själv, så du kan gå direkt till jobbet du behöver.";
"conversion.guide.tools.title" = "Tre verktyg för mediakomprimering";
"conversion.guide.image.detail" = "Komprimera bilder, justera utdataformatet och storleken och ta bort platsmetadata innan du delar.";
"conversion.guide.video.detail" = "Komprimera video genom att välja en behållare, codec och upplösning. Det slutliga stödet beror på enheten och källan.";
"conversion.guide.audio.detail" = "Komprimera ljudfiler – eller välj en video här för att extrahera och komprimera dess ljudspår.";
"conversion.guide.controls.title" = "Forma kompressionen";
"conversion.guide.format.detail" = "Välj ett format som balanserar kompatibilitet, kvalitet och filstorlek för hur filen kommer att användas.";
"conversion.guide.quality.detail" = "Använd bildkvalitet, videocodec och upplösning eller AAC-bithastighet för att minska storleken. Förlustfria ljudformat bevarar kvaliteten men kanske inte minskar storleken.";
"conversion.guide.metadata.detail" = "Bevara all skrivbar metadata, ta bort endast GPS eller ta bort allt. GPS-borttagning är standard.";
"conversion.guide.privacy.title" = "Dina original förblir dina";
"conversion.guide.privacy.detail" = "Allt bearbetas på den här enheten. Rensa alla tar bara bort apphanterade kopior och utdata, aldrig dina original i foton eller filer.";
"conversion.guide.learn_more" = "Utforska det här verktyget";
"conversion.guide.quality.title" = "Kvalitet och storlek";
"conversion.guide.detail.purpose.title" = "Vad det är till för";
"conversion.guide.detail.workflow.title" = "Batch, framsteg och resultat";
"conversion.guide.output.detail" = "Den apphanterade utdatamappen visas i verktyget men är inte valbar. Använd Dela för att flytta ett resultat någon annanstans.";
"conversion.guide.image.purpose" = "Batch-komprimera statiska bilder efter format, kvalitet, längsta kant och metadata. En uppsättning alternativ gäller för den aktuella batchen utan att originalen ändras.";
"conversion.guide.image.imports.detail" = "Välj flera filer eller upp till 100 objekt från Foton. Format speglar den här enhetens kapacitet; RAW/DNG/ProRAW är endast import, och animerade bilder stöds inte.";
"conversion.guide.image.workflow.detail" = "Följ inspektions- och kompressionstillstånd, eller avbryt medan arbetet pågår; färdiga resultat kvarstår. Jämför storlekar och dela från varje filkort innan du rensar listan.";
"conversion.guide.image.quality.detail" = "JPG, HEIC, HEIF och WebP stöder 10 %–100 % kvalitet i steg om 5 %, med 85 % som standard. Lägre kvalitet skapar vanligtvis mindre filer med mer synlig förlust; andra format visar ingen kvalitetskontroll.";
"resize.square1024" = "1024 pixlar";
"conversion.guide.image.resize.detail" = "Behåll de ursprungliga måtten, eller täck den längsta kanten till 4096, 2048 eller 1280 px för att minska storleken utan att förstora. Alternativet 1024 × 1024 passar hela bilden på en kvadratisk bakgrund utan att beskäras eller sträckas ut; små bilder förstoras.";
"conversion.guide.image.transparency.detail" = "JPG och BMP kan inte lagra genomskinliga pixlar. När du använder något av formaten, fyll genomskinliga områden med vitt eller svart.";
"conversion.guide.video.purpose" = "Batchkomprimera MOV-, MP4- eller M4V-video med behållare, codec och upplösning utan att skriva över originalen.";
"conversion.guide.video.imports.detail" = "Välj flera MOV-, MP4- eller M4V-filer eller välj upp till 50 videor från Foton.";
"conversion.guide.video.workflow.detail" = "Videor bearbetas en efter en. Följ uppgiftstillstånd och slutfört antal, avbryt vid behov, jämför sedan inmatnings- och utdatastorlekar och dela varje resultat.";
"conversion.guide.video.resolution.detail" = "En lägre upplösning minskar vanligtvis filstorleken. H.264 erbjuder Original, 4K, 1080p, 720p och 480p; HEVC erbjuder Original, 4K och 1080p; ProRes behåller den ursprungliga upplösningen.";
"conversion.guide.video.compatibility.title" = "Kombinationer och enhetsstöd";
"conversion.guide.video.compatibility.detail" = "Behållar- och upplösningsvalen minskar när du har valt en codec. Enheten och källvideon får fortfarande en sista kompatibilitetskontroll.";
"conversion.guide.video.codec.h264.detail" = "Bredaste kompatibilitet: MP4, MOV eller M4V; Original, 4K, 1080p, 720p eller 480p.";
"conversion.guide.video.codec.hevc.detail" = "Mer effektiv komprimering: MP4 eller MOV; Original, 4K eller 1080p. Äldre enheter och appar kan vara mindre kompatibla.";
"conversion.guide.video.codec.prores422.detail" = "För högkvalitativ redigering: endast MOV, med originalupplösningen. Filer är vanligtvis stora och är inte avsedda för utrymmesbesparande komprimering.";
"conversion.guide.video.codec.prores4444.detail" = "För högkvalitativ efterproduktion: endast MOV, med originalupplösning. Filer är vanligtvis mycket stora och är inte avsedda för utrymmesbesparande komprimering.";
"conversion.guide.audio.purpose" = "Komprimera ljud eller skapa en separat komprimerad ljudfil från en video med ett användbart spår. Det ursprungliga ljudet och videon förblir oförändrade.";
"conversion.guide.audio.imports.detail" = "Välj ljud eller video från filer, eller välj videor från Foton för att extrahera deras ljudspår. Ljudingångar: M4A (inklusive ALAC), AAC, MP3, FLAC, WAV, AIFF/AIF och CAF. Videoingångar: MOV, MP4 och M4V.";
"conversion.guide.audio.workflow.detail" = "Följ källtyp, varaktighet, uppgiftstillstånd och slutfört antal, eller avbryt vid behov. Jämför in- och utdatastorlekar och dela det färdiga ljudet.";
"conversion.guide.audio.quality.detail" = "MP3 och AAC erbjuder 96, 128, 192, 256 eller 320 kbps; standard är 192 kbps. ALAC, WAV, AIFF och PCM CAF är förlustfria och använder inte en bithastighetsinställning.";
"conversion.guide.audio.m4a.title" = "M4A: container och codec";
"conversion.guide.audio.m4a.detail" = "M4A är filbehållaren, inte komprimeringsmetoden. M4A (AAC) använder förlustkomprimering för mindre, delbara filer; M4A (Apple Lossless/ALAC) bevarar källans tillgängliga kvalitet men är vanligtvis större. Välj AAC för daglig lagring och delning, eller ALAC när du undviker ytterligare kvalitetsförlust är viktigare än storlek.";
"conversion.guide.audio.lossless.title" = "Förlustfria format";
"conversion.guide.audio.lossless.detail" = "M4A (ALAC) och CAF ALAC använder förlustfri kompression; WAV, AIFF och CAF PCM lagrar okomprimerat ljud och är vanligtvis större. Dessa format bevarar den tillgängliga kvaliteten i källan och använder ingen bithastighetsinställning. Att konvertera MP3 eller AAC till förlustfri kan inte återställa detaljer som redan tagits bort genom förlustkomprimering.";
"conversion.guide.audio.extract.title" = "Utdrag från video";
"conversion.guide.audio.extract.detail" = "Välj MOV, MP4 eller M4V från Filer eller Foton för att läsa dess tillgängliga ljudspår och koda om det i det valda formatet. Videon ändras inte; skyddad video eller video utan ljud kan inte extraheras.";
"settings.background" = "Bakgrund";
"color.transparent" = "Transparent";
"settings.background.detail" = "Gäller genomskinliga pixlar och fyrkantig stoppning; det tar inte bort bildbakgrunden. Transparens är tillgänglig för PNG och TIFF. Andra format återställer transparensen till vitt.";
