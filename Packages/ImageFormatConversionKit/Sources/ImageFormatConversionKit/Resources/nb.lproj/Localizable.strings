"conversion.guide.button" = "Åpne kompresjonsguide";
"conversion.guide.title" = "Kompresjonsguide";
"conversion.guide.hero.title" = "Komprimer media, spar plass";
"conversion.guide.hero.detail" = "Komprimer bilder, video og lyd lokalt på denne enheten uten å endre originalene.";
"conversion.guide.steps.title" = "Rask start";
"conversion.guide.step.choose.title" = "Velg en medietype";
"conversion.guide.step.choose.detail" = "Importer bilder og video fra bilder eller filer. Lydverktøyet godtar lyd eller video fra filer.";
"conversion.guide.step.adjust.title" = "Juster kompresjon";
"conversion.guide.step.adjust.detail" = "Velg et format og juster kvalitet, oppløsning, bithastighet eller metadata etter behov.";
"conversion.guide.step.convert.title" = "Komprimer og del";
"conversion.guide.step.convert.detail" = "Følg komprimeringsfremgangen, gjennomgå resultatet, og del det deretter hvor du måtte trenge det.";
"conversion.guide.home.title" = "Start med filen du vil krympe";
"conversion.guide.home.detail" = "Hvert verktøy står for seg selv, slik at du kan gå rett til jobben du trenger.";
"conversion.guide.tools.title" = "Tre mediekomprimeringsverktøy";
"conversion.guide.image.detail" = "Komprimer bilder, juster utdataformatet og størrelsen, og fjern plasseringsmetadata før deling.";
"conversion.guide.video.detail" = "Komprimer video ved å velge en beholder, kodek og oppløsning. Endelig støtte avhenger av enheten og kilden.";
"conversion.guide.audio.detail" = "Komprimer lydfiler – eller velg en video her for å trekke ut og komprimere lydsporet.";
"conversion.guide.controls.title" = "Form kompresjonen";
"conversion.guide.format.detail" = "Velg et format som balanserer kompatibilitet, kvalitet og filstørrelse for hvordan filen skal brukes.";
"conversion.guide.quality.detail" = "Bruk bildekvalitet, videokodek og oppløsning, eller AAC-bithastighet for å redusere størrelsen. Tapsfrie lydformater bevarer kvaliteten, men reduserer kanskje ikke størrelsen.";
"conversion.guide.metadata.detail" = "Ta vare på alle skrivbare metadata, fjern kun GPS eller fjern alt. GPS-fjerning er standard.";
"conversion.guide.privacy.title" = "Originalene dine forblir dine";
"conversion.guide.privacy.detail" = "Alt behandles på denne enheten. Fjern alt fjerner bare app-administrerte kopier og utdata, aldri originalene dine i Bilder eller filer.";
"conversion.guide.learn_more" = "Utforsk dette verktøyet";
"conversion.guide.quality.title" = "Kvalitet og størrelse";
"conversion.guide.detail.purpose.title" = "Hva det er til";
"conversion.guide.detail.workflow.title" = "Batch, fremgang og resultater";
"conversion.guide.output.detail" = "Den appadministrerte utdatamappen vises i verktøyet, men kan ikke velges. Bruk Del for å flytte et resultat et annet sted.";
"conversion.guide.image.purpose" = "Batch-komprimer statiske bilder etter format, kvalitet, lengste kant og metadata. Ett sett med alternativer gjelder for gjeldende batch uten å endre originalene.";
"conversion.guide.image.imports.detail" = "Velg flere filer, eller opptil 100 elementer fra Bilder. Formater gjenspeiler denne enhetens muligheter; RAW/DNG/ProRAW er kun for import, og animerte bilder støttes ikke.";
"conversion.guide.image.workflow.detail" = "Følg inspeksjons- og kompresjonstilstander, eller avbryt mens arbeidet pågår; fullførte resultater gjenstår. Sammenlign størrelser og del fra hvert filkort før du sletter listen.";
"conversion.guide.image.quality.detail" = "JPG, HEIC, HEIF og WebP støtter 10 %–100 % kvalitet i 5 % trinn, med 85 % som standard. Lavere kvalitet skaper vanligvis mindre filer med mer synlig tap; andre formater viser ingen kvalitetskontroll.";
"resize.square1024" = "1024 piksler";
"conversion.guide.image.resize.detail" = "Behold de originale dimensjonene, eller dekk den lengste kanten til 4096, 2048 eller 1280 px for å redusere størrelsen uten å forstørre. Alternativet 1024 × 1024 passer hele bildet på en firkantet bakgrunn uten å beskjære eller strekke; små bilder forstørres.";
"conversion.guide.image.transparency.detail" = "JPG og BMP kan ikke lagre gjennomsiktige piksler. Når du bruker begge formatene, fyll gjennomsiktige områder med hvitt eller svart.";
"conversion.guide.video.purpose" = "Batchkomprimer MOV-, MP4- eller M4V-video etter beholder, kodek og oppløsning uten å overskrive originalene.";
"conversion.guide.video.imports.detail" = "Velg flere MOV-, MP4- eller M4V-filer, eller velg opptil 50 videoer fra Bilder.";
"conversion.guide.video.workflow.detail" = "Videoer behandles én etter én. Følg oppgavestatus og fullført telling, avbryt ved behov, sammenlign deretter inndata- og utdatastørrelser og del hvert resultat.";
"conversion.guide.video.resolution.detail" = "Redusering av oppløsning reduserer vanligvis filstørrelsen. H.264 tilbyr Original, 4K, 1080p, 720p og 480p; HEVC tilbyr Original, 4K og 1080p; ProRes beholder den opprinnelige oppløsningen.";
"conversion.guide.video.compatibility.title" = "Kombinasjoner og enhetsstøtte";
"conversion.guide.video.compatibility.detail" = "Beholder- og oppløsningsvalg begrenses etter at du har valgt en kodek. Enheten og kildevideoen mottar fortsatt en siste kompatibilitetssjekk.";
"conversion.guide.video.codec.h264.detail" = "Bredeste kompatibilitet: MP4, MOV eller M4V; Original, 4K, 1080p, 720p eller 480p.";
"conversion.guide.video.codec.hevc.detail" = "Mer effektiv komprimering: MP4 eller MOV; Original, 4K eller 1080p. Eldre enheter og apper kan være mindre kompatible.";
"conversion.guide.video.codec.prores422.detail" = "For redigering av høy kvalitet: Kun MOV, med original oppløsning. Filer er vanligvis store og er ikke beregnet på plassbesparende komprimering.";
"conversion.guide.video.codec.prores4444.detail" = "For høykvalitets etterproduksjon: Kun MOV, med original oppløsning. Filer er vanligvis veldig store og er ikke beregnet på plassbesparende komprimering.";
"conversion.guide.audio.purpose" = "Komprimer lyd eller lag en separat komprimert lydfil fra en video med et brukbart spor. Den originale lyden og videoen forblir uendret.";
"conversion.guide.audio.imports.detail" = "Velg lyd eller video fra filer, eller velg videoer fra Bilder for å trekke ut lydsporene deres. Lydinnganger: M4A (inkludert ALAC), AAC, MP3, FLAC, WAV, AIFF/AIF og CAF. Videoinnganger: MOV, MP4 og M4V.";
"conversion.guide.audio.workflow.detail" = "Følg kildetype, varighet, oppgavestatus og fullført telling, eller avbryt ved behov. Sammenlign inngangs- og utdatastørrelser og del den ferdige lyden.";
"conversion.guide.audio.quality.detail" = "MP3 og AAC tilbyr 96, 128, 192, 256 eller 320 kbps; the default is 192 kbps. ALAC, WAV, AIFF og PCM CAF er tapsfrie og bruker ikke en bitrate-innstilling.";
"conversion.guide.audio.m4a.title" = "M4A: container and codec";
"conversion.guide.audio.m4a.detail" = "M4A er filbeholderen, ikke komprimeringsmetoden. M4A (AAC) bruker tapskomprimering for mindre, delbare filer; M4A (Apple Lossless/ALAC) bevarer kildens tilgjengelige kvalitet, men er vanligvis større. Velg AAC for daglig lagring og deling, eller ALAC når du unngår ytterligere kvalitetstap betyr mer enn størrelse.";
"conversion.guide.audio.lossless.title" = "Lossless formats";
"conversion.guide.audio.lossless.detail" = "M4A (ALAC) og CAF ALAC bruker tapsfri kompresjon; WAV, AIFF og CAF PCM lagrer ukomprimert lyd og er vanligvis større. Disse formatene bevarer kvaliteten som er tilgjengelig i kilden og bruker ikke en bithastighetsinnstilling. Konvertering av MP3 eller AAC til tapsfri kan ikke gjenopprette detaljer som allerede er fjernet ved tapskomprimering.";
"conversion.guide.audio.extract.title" = "Utdrag fra video";
"conversion.guide.audio.extract.detail" = "Velg MOV, MP4 eller M4V fra Filer eller Bilder for å lese det tilgjengelige lydsporet og kode det på nytt i det valgte formatet. Videoen er ikke endret; beskyttet video eller video uten lyd kan ikke trekkes ut.";
"settings.background" = "Bakgrunn";
"color.transparent" = "Gjennomsiktig";
"settings.background.detail" = "Gjelder gjennomsiktige piksler og firkantet polstring; det fjerner ikke bildebakgrunnen. Gjennomsiktighet er tilgjengelig for PNG og TIFF. Andre formater tilbakestiller gjennomsiktigheten til hvit.";
