"conversion.guide.button" = "Apri la Guida alla compressione";
"conversion.guide.title" = "Guida alla compressione";
"conversion.guide.hero.title" = "Comprimi i media, risparmia spazio";
"conversion.guide.hero.detail" = "Comprimi immagini, video e audio localmente su questo dispositivo senza modificare gli originali.";
"conversion.guide.steps.title" = "Avvio rapido";
"conversion.guide.step.choose.title" = "Scegli un tipo di supporto";
"conversion.guide.step.choose.detail" = "Importa immagini e video da foto o file. Lo strumento Audio accetta audio o video dai file.";
"conversion.guide.step.adjust.title" = "Regolare la compressione";
"conversion.guide.step.adjust.detail" = "Scegli un formato e regola la qualità, la risoluzione, il bitrate o i metadati secondo necessità.";
"conversion.guide.step.convert.title" = "Comprimi e condividi";
"conversion.guide.step.convert.detail" = "Segui l'avanzamento della compressione, rivedi il risultato e condividilo ovunque ti serva.";
"conversion.guide.home.title" = "Inizia con il file che desideri ridurre";
"conversion.guide.home.detail" = "Ogni strumento è autonomo, quindi puoi andare direttamente al lavoro di cui hai bisogno.";
"conversion.guide.tools.title" = "Tre strumenti di compressione multimediale";
"conversion.guide.image.detail" = "Comprimi le immagini, regola il formato e le dimensioni di output e rimuovi i metadati della posizione prima della condivisione.";
"conversion.guide.video.detail" = "Comprimi il video scegliendo un contenitore, un codec e una risoluzione. Il supporto finale dipende dal dispositivo e dalla fonte.";
"conversion.guide.audio.detail" = "Comprimi i file audio oppure seleziona un video qui per estrarre e comprimerne la traccia audio.";
"conversion.guide.controls.title" = "Modella la compressione";
"conversion.guide.format.detail" = "Scegli un formato che bilanci compatibilità, qualità e dimensione del file per come verrà utilizzato il file.";
"conversion.guide.quality.detail" = "Utilizza la qualità dell'immagine, il codec video e la risoluzione o il bitrate AAC per ridurre le dimensioni. I formati audio senza perdita di dati preservano la qualità ma potrebbero non ridurre le dimensioni.";
"conversion.guide.metadata.detail" = "Conserva tutti i metadati scrivibili, rimuovi solo il GPS o rimuovi tutto. La rimozione del GPS è l'impostazione predefinita.";
"conversion.guide.replace.title" = "Sostituisci gli originali";
"conversion.guide.replace.detail" = "Dopo la compressione, tocca il cestino nella schermata principale e seleziona le raccolte di immagini o video. L’app salva prima le copie compresse in Foto, poi iOS chiede di confermare l’eliminazione degli originali corrispondenti. Sono idonei solo gli elementi completati importati da Foto; audio autonomi e importazioni da File non sono supportati. Cancella tutto rimuove solo le copie di lavoro e disattiva la sostituzione, senza eliminare gli originali.";
"conversion.guide.privacy.title" = "I tuoi originali rimangono tuoi";
"conversion.guide.privacy.detail" = "Tutto viene elaborato su questo dispositivo. Cancella tutto rimuove solo le copie e gli output gestiti dall'app, mai gli originali in Foto o File.";
"conversion.guide.learn_more" = "Esplora questo strumento";
"conversion.guide.quality.title" = "Qualità e dimensioni";
"conversion.guide.detail.purpose.title" = "A cosa serve";
"conversion.guide.detail.workflow.title" = "Lotto, progresso e risultati";
"conversion.guide.output.detail" = "La cartella di output gestita dall'app viene visualizzata nello strumento ma non è selezionabile. Utilizza Condividi per spostare un risultato altrove.";
"conversion.guide.image.purpose" = "Compressione in batch di immagini statiche in base a formato, qualità, bordo più lungo e metadati. Una serie di opzioni si applica al batch corrente senza modificare gli originali.";
"conversion.guide.image.imports.detail" = "Seleziona più file o fino a 100 elementi da Foto. I formati riflettono le capacità di questo dispositivo; RAW/DNG/ProRAW sono di sola importazione e le immagini animate non sono supportate.";
"conversion.guide.image.workflow.detail" = "Seguire gli stati di ispezione e compressione o annullare mentre il lavoro è in corso; rimangono i risultati completati. Confronta le dimensioni e condividi da ciascuna scheda prima di cancellare l'elenco.";
"conversion.guide.image.quality.detail" = "JPG, HEIC, HEIF e WebP supportano una qualità dal 10% al 100% con incrementi del 5%, con 85% come impostazione predefinita. Una qualità inferiore solitamente crea file più piccoli con perdite più visibili; altri formati non mostrano un controllo di qualità.";
"resize.square1024" = "1024px";
"conversion.guide.image.resize.detail" = "Mantieni le dimensioni originali o limita il bordo più lungo a 4096, 2048 o 1280 px per ridurre le dimensioni senza ingrandirle. L'opzione 1024 × 1024 adatta l'intera immagine su uno sfondo quadrato senza ritagliarla o allungarla; le immagini piccole vengono ingrandite.";
"conversion.guide.image.transparency.detail" = "JPG e BMP non possono memorizzare pixel trasparenti. Quando utilizzi uno dei due formati, riempi le aree trasparenti con il bianco o il nero.";
"conversion.guide.video.purpose" = "Comprimi in batch video MOV, MP4 o M4V per contenitore, codec e risoluzione senza sovrascrivere gli originali.";
"conversion.guide.video.imports.detail" = "Seleziona più file MOV, MP4 o M4V oppure scegli fino a 50 video da Foto.";
"conversion.guide.video.workflow.detail" = "I video vengono elaborati uno per uno. Segui lo stato delle attività e il conteggio completato, annulla quando necessario, quindi confronta le dimensioni di input e output e condividi ogni risultato.";
"conversion.guide.video.resolution.detail" = "Abbassando la risoluzione di solito si riducono le dimensioni del file. H.264 offre Originale, 4K, 1080p, 720p e 480p; HEVC offre Originale, 4K e 1080p; ProRes mantiene la risoluzione originale.";
"conversion.guide.video.compatibility.title" = "Combinazioni e supporto del dispositivo";
"conversion.guide.video.compatibility.detail" = "Le scelte relative al contenitore e alla risoluzione si restringono dopo aver selezionato un codec. Il dispositivo e il video sorgente ricevono ancora un controllo di compatibilità finale.";
"conversion.guide.video.codec.h264.detail" = "Massima compatibilità: MP4, MOV o M4V; Originale, 4K, 1080p, 720p o 480p.";
"conversion.guide.video.codec.hevc.detail" = "Compressione più efficiente: MP4 o MOV; Originale, 4K o 1080p. I dispositivi e le app meno recenti potrebbero essere meno compatibili.";
"conversion.guide.video.codec.prores422.detail" = "Per editing di alta qualità: solo MOV, alla risoluzione originale. I file sono generalmente di grandi dimensioni e non sono destinati alla compressione salvaspazio.";
"conversion.guide.video.codec.prores4444.detail" = "Per una post-produzione di alta qualità: solo MOV, alla risoluzione originale. I file sono generalmente molto grandi e non sono destinati alla compressione salvaspazio.";
"conversion.guide.audio.purpose" = "Comprimi l'audio o crea un file audio compresso separato da un video con una traccia utilizzabile. L'audio e il video originali rimangono invariati.";
"conversion.guide.audio.imports.detail" = "Seleziona audio o video da File oppure seleziona video da Foto per estrarne le tracce audio. Ingressi audio: M4A (incluso ALAC), AAC, MP3, FLAC, WAV, AIFF/AIF e CAF. Ingressi video: MOV, MP4 e M4V.";
"conversion.guide.audio.workflow.detail" = "Segui il tipo di origine, la durata, lo stato dell'attività e il conteggio completato oppure annulla quando necessario. Confronta le dimensioni di input e output e condividi l'audio finito.";
"conversion.guide.audio.quality.detail" = "MP3 e AAC offrono 96, 128, 192, 256 o 320 kbps; il valore predefinito è 192 kbps. ALAC, WAV, AIFF e PCM CAF sono senza perdita di dati e non utilizzano un'impostazione del bitrate.";
"conversion.guide.audio.m4a.title" = "M4A: contenitore e codec";
"conversion.guide.audio.m4a.detail" = "M4A è il contenitore dei file, non il metodo di compressione. M4A (AAC) utilizza la compressione con perdita per file più piccoli e condivisibili; M4A (Apple Lossless/ALAC) preserva la qualità disponibile della sorgente ma solitamente è più grande. Scegli AAC per l'archiviazione e la condivisione quotidiana o ALAC quando evitare ulteriori perdite di qualità sono più importanti delle dimensioni.";
"conversion.guide.audio.lossless.title" = "Formati senza perdite";
"conversion.guide.audio.lossless.detail" = "M4A (ALAC) e CAF ALAC utilizzano la compressione senza perdite; WAV, AIFF e CAF PCM memorizzano l'audio non compresso e solitamente sono più grandi. Questi formati preservano la qualità disponibile nell'origine e non utilizzano un'impostazione del bitrate. La conversione di MP3 o AAC in formato lossless non può ripristinare i dettagli già rimossi dalla compressione con perdita.";
"conversion.guide.audio.extract.title" = "Estratto dal video";
"conversion.guide.audio.extract.detail" = "Scegli MOV, MP4 o M4V da File o Foto per leggere la traccia audio disponibile e ricodificarla nel formato selezionato. Il video non è cambiato; non è possibile estrarre video protetti o video senza audio.";
"settings.background" = "Sfondo";
"color.transparent" = "Trasparente";
"settings.background.detail" = "Si applica ai pixel trasparenti e al riempimento quadrato; non rimuove lo sfondo dell'immagine. La trasparenza è disponibile per PNG e TIFF. Altri formati reimpostano la trasparenza sul bianco.";
