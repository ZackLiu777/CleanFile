"conversion.guide.audio_replace.title" = "Perché l’audio non può sostituire l’originale";
"conversion.guide.audio_replace.detail" = "I file audio provengono da File e iPhone non consente all’app di eliminare in sicurezza gli originali al posto tuo. L’audio compresso viene salvato come nuovo file. Dopo averlo controllato, elimina tu stesso il vecchio file in File.";
"video.settings.bitrate.help" = "Il 100% usa le valore automatico. Valori inferiori riducono il bitrate rispetto all'originale.";
"video.error.hdr_bitrate" = "Per preservare colori e luminosità HDR, usa il 100% (Auto).";
