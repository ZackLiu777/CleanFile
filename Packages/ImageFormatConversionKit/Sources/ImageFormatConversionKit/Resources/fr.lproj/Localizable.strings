"conversion.guide.button" = "Ouvrir le guide de compression";
"conversion.guide.title" = "Guide de compression";
"conversion.guide.hero.title" = "Compressez vos médias, gagnez de l’espace";
"conversion.guide.hero.detail" = "Compressez les images, les vidéos et l’audio localement sur cet appareil, sans modifier les originaux.";
"conversion.guide.steps.title" = "Démarrage rapide";
"conversion.guide.step.choose.title" = "Choisissez un type de média";
"conversion.guide.step.choose.detail" = "Importez les images et les vidéos depuis Photos ou Fichiers. L’outil Audio accepte les fichiers audio ou vidéo depuis Fichiers.";
"conversion.guide.step.adjust.title" = "Réglez la compression";
"conversion.guide.step.adjust.detail" = "Choisissez un format et ajustez la qualité, la résolution, le débit ou les métadonnées selon vos besoins.";
"conversion.guide.step.convert.title" = "Compressez et partagez";
"conversion.guide.step.convert.detail" = "Suivez la progression de la compression, vérifiez le résultat, puis partagez-le où vous le souhaitez.";
"conversion.guide.home.title" = "Commencez avec le fichier à réduire";
"conversion.guide.home.detail" = "Chaque outil est autonome pour vous mener directement à la tâche voulue.";
"conversion.guide.tools.title" = "Trois outils de compression multimédia";
"conversion.guide.image.detail" = "Compressez les images, ajustez le format et la taille, et supprimez la localisation avant le partage.";
"conversion.guide.video.detail" = "Compressez les vidéos en choisissant le conteneur, le codec et la résolution. La compatibilité finale dépend de l’appareil et de la source.";
"conversion.guide.audio.detail" = "Compressez l’audio ou sélectionnez ici une vidéo pour en extraire et compresser la piste audio.";
"conversion.guide.controls.title" = "Réglez la compression";
"conversion.guide.format.detail" = "Choisissez un format qui équilibre compatibilité, qualité et taille selon l’usage du fichier.";
"conversion.guide.quality.detail" = "Utilisez la qualité d’image, le codec et la résolution vidéo, ou le débit AAC, pour réduire la taille. Les formats audio sans perte préservent la qualité, mais ne réduisent pas toujours la taille.";
"conversion.guide.metadata.detail" = "Conservez les métadonnées inscriptibles, supprimez uniquement le GPS ou supprimez-les toutes. La suppression du GPS est le réglage par défaut.";
"conversion.guide.privacy.title" = "Vos originaux restent intacts";
"conversion.guide.privacy.detail" = "Tout est traité sur cet appareil. « Tout effacer » supprime uniquement les copies et sorties gérées par l’app, jamais les originaux dans Photos ou Fichiers.";
"conversion.guide.learn_more" = "En savoir plus";
"conversion.guide.quality.title" = "Qualité et taille";
"conversion.guide.detail.purpose.title" = "À quoi ça sert";
"conversion.guide.detail.workflow.title" = "Lots, progression et résultats";
"conversion.guide.output.detail" = "Le dossier de sortie est géré par l’app et son emplacement est affiché sans pouvoir être choisi. Utilisez Partager pour déplacer un résultat.";
"conversion.guide.image.purpose" = "Compressez des images fixes par lots et contrôlez le format, la qualité, le bord le plus long et les métadonnées. Les réglages s’appliquent au lot sans modifier les originaux.";
"conversion.guide.image.imports.detail" = "Sélectionnez plusieurs fichiers ou jusqu’à 100 éléments dans Photos. Les formats affichés dépendent des capacités de cet appareil ; RAW, DNG et ProRAW sont réservés à l’importation, et les images animées ne sont pas prises en charge.";
"conversion.guide.image.workflow.detail" = "Suivez les états de lecture et de compression, ou annulez pendant le traitement ; les résultats terminés sont conservés. Comparez les tailles et partagez depuis chaque carte avant d’effacer la liste.";
"conversion.guide.image.quality.detail" = "JPEG, HEIC, HEIF et WebP acceptent une qualité de 10 à 100 %, par pas de 5 %, avec 85 % par défaut. Une qualité moindre produit généralement des fichiers plus petits avec une perte plus visible ; les autres formats n’ont pas de réglage de qualité.";
"resize.square1024" = "1024px";
"conversion.guide.image.resize.detail" = "Conservez les dimensions d’origine ou limitez le bord le plus long à 4096, 2048 ou 1280 px pour réduire la taille sans agrandir. L’option 1024 × 1024 centre l’image entière sur un fond carré, avec des marges, sans recadrage ni déformation ; les petites images sont agrandies.";
"conversion.guide.image.transparency.detail" = "JPEG et BMP ne peuvent pas stocker les pixels transparents. Avec ces formats, remplissez les zones transparentes en blanc ou en noir.";
"conversion.guide.video.purpose" = "Compressez par lots des vidéos MOV, MP4 ou M4V en choisissant le conteneur, le codec et la résolution, sans écraser les originaux.";
"conversion.guide.video.imports.detail" = "Sélectionnez plusieurs fichiers MOV, MP4 ou M4V, ou jusqu’à 50 vidéos dans Photos.";
"conversion.guide.video.workflow.detail" = "Les vidéos sont traitées une par une. Consultez l’état et le nombre terminé, annulez si nécessaire, puis comparez les tailles et partagez chaque résultat.";
"conversion.guide.video.resolution.detail" = "Réduire la résolution réduit généralement la taille du fichier. H.264 propose Original, 4K, 1080p, 720p et 480p ; HEVC propose Original, 4K et 1080p ; ProRes conserve la résolution d’origine.";
"conversion.guide.video.compatibility.title" = "Combinaisons et compatibilité";
"conversion.guide.video.compatibility.detail" = "Les conteneurs et résolutions disponibles se réduisent selon le codec. La compatibilité finale est aussi vérifiée avec l’appareil et la vidéo source.";
"conversion.guide.video.codec.h264.detail" = "La compatibilité la plus large : MP4, MOV ou M4V, avec toutes les résolutions proposées.";
"conversion.guide.video.codec.hevc.detail" = "Une compression plus efficace sur les appareils récents : MP4 ou MOV en Original, 4K ou 1080p. Les anciens appareils et logiciels peuvent être moins compatibles.";
"conversion.guide.video.codec.prores422.detail" = "Codec de montage haute qualité : MOV uniquement, à la résolution d’origine ; les fichiers sont généralement volumineux et ne sont pas destinés à économiser de l’espace.";
"conversion.guide.video.codec.prores4444.detail" = "Codec haute qualité pour le post-traitement exigeant : MOV uniquement, à la résolution d’origine ; les fichiers sont généralement très volumineux et ne sont pas destinés à économiser de l’espace.";
"conversion.guide.audio.purpose" = "Compressez des fichiers audio pris en charge ou créez un fichier audio compressé séparé à partir d’une vidéo contenant une piste lisible. Les originaux restent inchangés.";
"conversion.guide.audio.imports.detail" = "Sélectionnez plusieurs éléments dans Fichiers uniquement. Audio : M4A, AAC, MP3, WAV, AIFF/AIF, CAF. Vidéo : MOV, MP4, M4V. Le MP3 est réservé à l’importation.";
"conversion.guide.audio.workflow.detail" = "Consultez le type de source, la durée, l’état et le nombre terminé, ou annulez si nécessaire. Comparez les tailles et partagez l’audio terminé.";
"conversion.guide.audio.quality.detail" = "Les sorties AAC proposent 96, 128, 192 ou 256 kbit/s, avec 192 kbit/s par défaut. Un débit moindre produit généralement des fichiers plus petits avec une perte plus audible ; un débit supérieur conserve généralement plus de détails.";
"conversion.guide.audio.lossless.title" = "Formats sans perte";
"conversion.guide.audio.lossless.detail" = "M4A (ALAC), WAV, AIFF, CAF PCM et CAF ALAC n’utilisent pas le réglage de débit. Ils préservent la qualité audio disponible, mais ne réduisent pas toujours la taille du fichier.";
"conversion.guide.audio.extract.title" = "Extraire d’une vidéo";
"conversion.guide.audio.extract.detail" = "Choisissez un fichier MOV, MP4 ou M4V dans Fichiers pour lire sa piste audio disponible et la réencoder dans le format choisi. La vidéo n’est pas modifiée ; une vidéo protégée ou sans audio ne peut pas être extraite.";
"settings.background" = "Arrière-plan";
"color.transparent" = "Transparent";
"settings.background.detail" = "S’applique aux pixels transparents et aux marges carrées, sans supprimer le fond de l’image. La transparence est disponible en PNG et TIFF. Les autres formats rétablissent le blanc.";
