"conversion.guide.image.detail" = "JPG, PNG, HEIC ja muut. Säädä kuvan laatua ja mittoja.";
"conversion.guide.video.detail" = "MP4, MOV, M4V. Valitse koodekki, bittinopeus ja tarkkuus.";
"conversion.guide.audio.detail" = "MP3, AAC, WAV ja muut. Säädä bittinopeutta tai poimi ääni videosta.";
"conversion.guide.controls.title" = "Muotoile puristus";
"conversion.guide.format.detail" = "Valitse muoto, jossa yhteensopivuus, laatu ja tiedostokoko ovat tasapainossa tiedoston käytön suhteen.";
"conversion.guide.quality.detail" = "Pienempi laatu tai bittinopeus yleensä pienentää tiedostoa. Tulos riippuu sisällöstä; häviöttömät muodot eivät aina pienene.";
"conversion.guide.metadata.detail" = "Säilytä kaikki kirjoitettavat metatiedot, poista vain GPS tai poista kaikki. GPS-poisto on oletusarvo.";
"conversion.guide.replace.title" = "Korvaa alkuperäiset";
"conversion.guide.replace.detail" = "Muunnamisen jälkeen napauta aloitusnäkymän roskakoria ja valitse kuva- tai videokokoelmat. Appi tallentaa ensin pakatut kopiot Kuviin, minkä jälkeen iOS pyytää vahvistamaan vastaavien alkuperäisten poistamisen. Vain Kuvista tuodut valmiit kohteet ovat käytettävissä; erillistä ääntä ja Tiedostoista tuotuja kohteita ei tueta. Tyhjennä kaikki poistaa vain työkopiot ja estää korvaamisen, mutta ei poista alkuperäisiä.";
"conversion.guide.privacy.title" = "Alkuperäiset jäävät sinun";
"conversion.guide.privacy.detail" = "Kaikki käsitellään tällä laitteella. Tyhjennä kaikki poistaa vain sovelluksen hallinnoimat kopiot ja tulosteet, ei koskaan alkuperäisiä kuviasi tai tiedostoistasi.";
"conversion.guide.learn_more" = "Tutustu tähän työkaluun";
"conversion.guide.quality.title" = "Laatu ja koko";
"conversion.guide.detail.purpose.title" = "Mitä varten se on";
"conversion.guide.detail.workflow.title" = "Erä, edistyminen ja tulokset";
"conversion.guide.output.detail" = "Sovelluksen hallinnoima tulostekansio näkyy työkalussa, mutta sitä ei voi valita. Käytä Jaa siirtääksesi tuloksen muualle.";
"conversion.guide.image.purpose" = "JPG, PNG, HEIC ja muut. Säädä kuvan laatua ja mittoja.";
"conversion.guide.image.imports.detail" = "Valitse useita tiedostoja tai enintään 100 kohdetta Kuvista. Muodot kuvastavat tämän laitteen ominaisuuksia; RAW/DNG/ProRAW ovat vain tuontia, eikä animoituja kuvia tueta.";
"conversion.guide.image.workflow.detail" = "Seuraa tarkastus- ja muunnostiloja tai peruuta työn ollessa käynnissä; valmiit tulokset säilyvät. Vertaa kokoja ja jaa jokaisesta tiedostokortista ennen luettelon tyhjentämistä.";
"conversion.guide.image.quality.detail" = "JPG, PNG, HEIC ja muut. Säädä kuvan laatua ja mittoja. Pienempi laatu tai bittinopeus yleensä pienentää tiedostoa. Tulos riippuu sisällöstä; häviöttömät muodot eivät aina pienene.";
"resize.square1024" = "1024 pikseliä";
"conversion.guide.image.resize.detail" = "Säilytä alkuperäiset mitat tai rajaa pisin reuna 4096, 2048 tai 1280 pikseliin pienentääksesi kokoa ilman suurennusta. 1024 × 1024 -vaihtoehto sopii koko kuvan neliömäiselle taustalle ilman rajausta tai venyttämistä; pienet kuvat suurennetaan.";
"conversion.guide.image.transparency.detail" = "JPG ja BMP eivät voi tallentaa läpinäkyviä pikseleitä. Kun käytät jompaakumpaa muotoa, täytä läpinäkyvät alueet valkoisella tai mustalla.";
"conversion.guide.video.purpose" = "MP4, MOV, M4V. Valitse koodekki, bittinopeus ja tarkkuus.";
"conversion.guide.video.imports.detail" = "Valitse useita MOV-, MP4- tai M4V-tiedostoja tai valitse jopa 50 videota Kuvista.";
"conversion.guide.video.workflow.detail" = "Videot käsitellään yksitellen. Seuraa tehtävän tiloja ja suoritettuja laskelmia, peruuta tarvittaessa, vertaa sitten tulo- ja tuloskokoja ja jaa jokainen tulos.";
"conversion.guide.video.resolution.detail" = "Tarkkuuden pienentäminen yleensä pienentää tiedostokokoa. H.264 tarjoaa Original, 4K, 1080p, 720p ja 480p; HEVC tarjoaa Original, 4K ja 1080p; ProRes säilyttää alkuperäisen resoluution.";
"conversion.guide.video.compatibility.title" = "Yhdistelmät ja laitetuki";
"conversion.guide.video.compatibility.detail" = "Säilön ja resoluution valinnat kapenevat, kun olet valinnut koodekin. Laite ja lähdevideo saavat silti viimeisen yhteensopivuustarkistuksen.";
"conversion.guide.video.codec.h264.detail" = "Laajin yhteensopivuus: MP4, MOV tai M4V; Alkuperäinen, 4K, 1080p, 720p tai 480p.";
"conversion.guide.video.codec.hevc.detail" = "Tehokkaampi muunnos: MP4 tai MOV; Alkuperäinen, 4K tai 1080p. Vanhemmat laitteet ja sovellukset voivat olla vähemmän yhteensopivia.";
"conversion.guide.video.codec.prores422.detail" = "Korkealaatuiseen editointiin: vain MOV, alkuperäisellä resoluutiolla. Tiedostot ovat yleensä suuria, eikä niitä ole tarkoitettu tilaa säästävään muunnamiseen.";
"conversion.guide.video.codec.prores4444.detail" = "Korkealaatuiseen jälkituotantoon: vain MOV, alkuperäisellä resoluutiolla. Tiedostot ovat yleensä erittäin suuria, eikä niitä ole tarkoitettu tilaa säästävään muunnamiseen.";
"conversion.guide.audio.purpose" = "MP3, AAC, WAV ja muut. Säädä bittinopeutta tai poimi ääni videosta.";
"conversion.guide.audio.imports.detail" = "Valitse ääni tai video tiedostoista tai valitse videoita Valokuvista poimiaksesi ääniraidat. Äänitulot: M4A (mukaan lukien ALAC), AAC, MP3, FLAC, WAV, AIFF/AIF ja CAF. Videotulot: MOV, MP4 ja M4V.";
"conversion.guide.audio.workflow.detail" = "Seuraa lähteen tyyppiä, kestoa, tehtävän tilaa ja valmistuneiden lukumäärää tai peruuta tarvittaessa. Vertaa tulo- ja lähtökokoja ja jaa valmis ääni.";
"conversion.guide.audio.quality.detail" = "MP3 ja AAC tarjoavat 96, 128, 192, 256 tai 320 kbps; oletusnopeus on 192 kbps. ALAC, WAV, AIFF ja PCM CAF ovat häviöttömiä eivätkä käytä bittinopeusasetusta.";
"conversion.guide.audio.m4a.title" = "M4A: kontti ja koodekki";
"conversion.guide.audio.m4a.detail" = "M4A on tiedostosäiliö, ei muunnosmenetelmä. M4A (AAC) käyttää häviöllistä muunnosta pienemmille, jaettaville tiedostoille; M4A (Apple Lossless/ALAC) säilyttää lähteen saatavilla olevan laadun, mutta on yleensä suurempi. Valitse AAC päivittäiseen säilytykseen ja jakamiseen tai ALAC, kun vältät lisälaadun heikkenemisen.";
"conversion.guide.audio.lossless.title" = "Häviöttömät formaatit";
"conversion.guide.audio.lossless.detail" = "M4A (ALAC) ja CAF ALAC käyttävät häviötöntä muunnosta; WAV, AIFF ja CAF PCM tallentavat muunnamatonta ääntä ja ovat yleensä suurempia. Nämä muodot säilyttävät lähteessä saatavilla olevan laadun eivätkä käytä bittinopeusasetusta. MP3:n tai AAC:n muuntaminen häviöttömäksi ei voi palauttaa häviöisellä pakkauksella jo poistettuja yksityiskohtia.";
"conversion.guide.audio.extract.title" = "Ote videosta";
"conversion.guide.audio.extract.detail" = "Valitse MOV, MP4 tai M4V tiedostoista tai kuvista lukeaksesi sen käytettävissä olevan ääniraidan ja koodataksesi sen uudelleen valittuun muotoon. Videota ei ole muutettu; suojattua videota tai videota ilman ääntä ei voi purkaa.";
"settings.background" = "Tausta";
"color.transparent" = "Läpinäkyvä";
"settings.background.detail" = "Koskee läpinäkyviä pikseleitä ja neliömäisiä pehmusteita; se ei poista kuvan taustaa. Läpinäkyvyys on saatavilla PNG- ja TIFF-muodoissa. Muut muodot palauttavat läpinäkyvyyden valkoiseksi.";
