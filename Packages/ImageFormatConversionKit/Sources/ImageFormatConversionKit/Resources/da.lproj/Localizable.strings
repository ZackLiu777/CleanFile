"conversion.guide.title" = "Kompressionsguide";
"conversion.guide.hero.title" = "Komprimer medier, spar plads";
"conversion.guide.hero.detail" = "Komprimer billeder, video og lyd lokalt på denne enhed uden at ændre originalerne.";
"conversion.guide.steps.title" = "Hurtig start";
"conversion.guide.step.choose.title" = "Vælg en medietype";
"conversion.guide.step.choose.detail" = "Importer billeder og video fra fotos eller filer. Lydværktøjet accepterer lyd eller video fra filer.";
"conversion.guide.step.adjust.title" = "Juster kompression";
"conversion.guide.step.adjust.detail" = "Vælg et format og juster kvalitet, opløsning, bitrate eller metadata efter behov.";
"conversion.guide.step.convert.title" = "Komprimer og del";
"conversion.guide.step.convert.detail" = "Følg komprimeringens fremskridt, gennemgå resultatet, og del det derefter, hvor du har brug for det.";
"conversion.guide.home.title" = "Start med den fil, du vil formindske";
"conversion.guide.home.detail" = "Hvert værktøj står for sig selv, så du kan gå direkte til det job, du har brug for.";
"conversion.guide.tools.title" = "Tre mediekomprimeringsværktøjer";
"conversion.guide.image.detail" = "Komprimer billeder, juster outputformatet og -størrelsen, og fjern lokationsmetadata før deling.";
"conversion.guide.video.detail" = "Komprimer video ved at vælge en beholder, codec og opløsning. Den endelige support afhænger af enheden og kilden.";
"conversion.guide.audio.detail" = "Komprimer lydfiler - eller vælg en video her for at udtrække og komprimere dens lydspor.";
"conversion.guide.controls.title" = "Form kompressionen";
"conversion.guide.format.detail" = "Vælg et format, der balancerer kompatibilitet, kvalitet og filstørrelse for, hvordan filen skal bruges.";
"conversion.guide.quality.detail" = "Brug billedkvalitet, video-codec og opløsning eller AAC-bitrate for at reducere størrelsen. Tabsfri lydformater bevarer kvaliteten, men reducerer muligvis ikke størrelsen.";
"conversion.guide.metadata.detail" = "Bevar alle skrivbare metadata, fjern kun GPS, eller fjern alt. GPS-fjernelse er standard.";
"conversion.guide.replace.title" = "Erstat originaler";
"conversion.guide.replace.detail" = "Efter komprimering skal du trykke på papirkurven på startsiden og vælge billed- eller videosamlinger. Appen gemmer først de komprimerede kopier i Fotos, hvorefter iOS beder dig bekræfte sletning af de tilsvarende originaler. Kun færdige emner importeret fra Fotos understøttes; selvstændig lyd og import fra Filer understøttes ikke. Ryd alle fjerner kun arbejdskopier og deaktiverer erstatning, men sletter aldrig originaler.";
"conversion.guide.privacy.title" = "Dine originaler forbliver dine";
"conversion.guide.privacy.detail" = "Alt behandles på denne enhed. Ryd alle fjerner kun app-administrerede kopier og output, aldrig dine originaler i Fotos eller Filer.";
"conversion.guide.learn_more" = "Udforsk dette værktøj";
"conversion.guide.quality.title" = "Kvalitet og størrelse";
"conversion.guide.detail.purpose.title" = "Hvad det er til";
"conversion.guide.detail.workflow.title" = "Batch, fremskridt og resultater";
"conversion.guide.output.detail" = "Den app-administrerede outputmappe vises i værktøjet, men kan ikke vælges. Brug Del til at flytte et resultat et andet sted hen.";
"conversion.guide.image.purpose" = "Batch-komprimer statiske billeder efter format, kvalitet, længste kant og metadata. Et sæt indstillinger gælder for den aktuelle batch uden at ændre originalerne.";
"conversion.guide.image.imports.detail" = "Vælg flere filer eller op til 100 elementer fra Fotos. Formater afspejler denne enheds muligheder; RAW/DNG/ProRAW er kun import, og animerede billeder understøttes ikke.";
"conversion.guide.image.workflow.detail" = "Følg inspektions- og kompressionstilstande, eller annuller, mens arbejdet er i gang; afsluttede resultater forbliver. Sammenlign størrelser og del fra hvert filkort, før du rydder listen.";
"conversion.guide.image.quality.detail" = "JPG, HEIC, HEIF og WebP understøtter 10 %–100 % kvalitet i 5 % trin, med 85 % som standard. Lavere kvalitet skaber normalt mindre filer med mere synligt tab; andre formater viser ikke en kvalitetskontrol.";
"resize.square1024" = "1024px";
"conversion.guide.image.resize.detail" = "Behold de originale dimensioner, eller dæk den længste kant til 4096, 2048 eller 1280 px for at reducere størrelsen uden at forstørre. Indstillingen 1024 × 1024 passer til hele billedet på en firkantet baggrund uden at beskære eller strække; små billeder forstørres.";
"conversion.guide.image.transparency.detail" = "JPG og BMP kan ikke gemme gennemsigtige pixels. Når du bruger begge formater, skal du udfylde gennemsigtige områder med hvid eller sort.";
"conversion.guide.video.purpose" = "Batchkomprimer MOV-, MP4- eller M4V-video efter beholder, codec og opløsning uden at overskrive originalerne.";
"conversion.guide.video.imports.detail" = "Vælg flere MOV-, MP4- eller M4V-filer, eller vælg op til 50 videoer fra Fotos.";
"conversion.guide.video.workflow.detail" = "Videoer behandles én efter én. Følg opgavetilstande og fuldført optælling, annuller efter behov, sammenlign input- og outputstørrelser og del hvert resultat.";
"conversion.guide.video.resolution.detail" = "Sænkning af opløsning reducerer normalt filstørrelsen. H.264 tilbyder Original, 4K, 1080p, 720p og 480p; HEVC tilbyder Original, 4K og 1080p; ProRes beholder den originale opløsning.";
"conversion.guide.video.compatibility.title" = "Kombinationer og enhedsunderstøttelse";
"conversion.guide.video.compatibility.detail" = "Beholder- og opløsningsvalg indsnævres, når du har valgt et codec. Enheden og kildevideoen modtager stadig et sidste kompatibilitetstjek.";
"conversion.guide.video.codec.h264.detail" = "Bredeste kompatibilitet: MP4, MOV eller M4V; Original, 4K, 1080p, 720p eller 480p.";
"conversion.guide.video.codec.hevc.detail" = "Mere effektiv komprimering: MP4 eller MOV; Original, 4K eller 1080p. Ældre enheder og apps kan være mindre kompatible.";
"conversion.guide.video.codec.prores422.detail" = "Til højkvalitetsredigering: Kun MOV i den originale opløsning. Filer er normalt store og er ikke beregnet til pladsbesparende komprimering.";
"conversion.guide.video.codec.prores4444.detail" = "Til efterproduktion af høj kvalitet: Kun MOV, i den originale opløsning. Filer er normalt meget store og er ikke beregnet til pladsbesparende komprimering.";
"conversion.guide.audio.purpose" = "Komprimer lyd eller opret en separat komprimeret lydfil fra en video med et brugbart spor. Den originale lyd og video forbliver uændret.";
"conversion.guide.audio.imports.detail" = "Vælg lyd eller video fra Filer, eller vælg videoer fra Fotos for at udtrække deres lydspor. Lydindgange: M4A (inklusive ALAC), AAC, MP3, FLAC, WAV, AIFF/AIF og CAF. Videoindgange: MOV, MP4 og M4V.";
"conversion.guide.audio.workflow.detail" = "Følg kildetype, varighed, opgavetilstand og fuldført optælling, eller annuller, når det er nødvendigt. Sammenlign input- og outputstørrelser og del den færdige lyd.";
"conversion.guide.audio.quality.detail" = "MP3 og AAC tilbyder 96, 128, 192, 256 eller 320 kbps; standarden er 192 kbps. ALAC, WAV, AIFF og PCM CAF er tabsfri og bruger ikke en bitrate-indstilling.";
"conversion.guide.audio.m4a.title" = "M4A: container og codec";
"conversion.guide.audio.m4a.detail" = "M4A er filbeholderen, ikke komprimeringsmetoden. M4A (AAC) bruger komprimering med tab til mindre, delbare filer; M4A (Apple Lossless/ALAC) bevarer kildens tilgængelige kvalitet, men er normalt større. Vælg AAC til daglig opbevaring og deling, eller ALAC, når du undgår yderligere kvalitetstab betyder mere end størrelse.";
"conversion.guide.audio.lossless.title" = "Tabsfri formater";
"conversion.guide.audio.lossless.detail" = "M4A (ALAC) og CAF ALAC bruger tabsfri kompression; WAV, AIFF og CAF PCM gemmer ukomprimeret lyd og er normalt større. Disse formater bevarer den tilgængelige kvalitet i kilden og bruger ikke en bithastighedsindstilling. Konvertering af MP3 eller AAC til tabsfri kan ikke gendanne detaljer, der allerede er fjernet ved tabskomprimering.";
"conversion.guide.audio.extract.title" = "Uddrag fra video";
"conversion.guide.audio.extract.detail" = "Vælg MOV, MP4 eller M4V fra Filer eller Billeder for at læse dets tilgængelige lydspor og genkode det i det valgte format. Videoen er ikke ændret; beskyttet video eller video uden lyd kan ikke udtrækkes.";
"settings.background" = "Baggrund";
"color.transparent" = "Gennemsigtig";
"settings.background.detail" = "Gælder for gennemsigtige pixels og firkantet polstring; det fjerner ikke billedbaggrunden. Gennemsigtighed er tilgængelig for PNG og TIFF. Andre formater nulstiller gennemsigtigheden til hvid.";
