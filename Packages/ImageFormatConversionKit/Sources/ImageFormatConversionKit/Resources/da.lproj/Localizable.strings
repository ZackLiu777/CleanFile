"conversion.guide.image.detail" = "JPG, PNG, HEIC og flere. Tilpas billedkvalitet og mål.";
"conversion.guide.video.detail" = "MP4, MOV, M4V. Vælg codec, bithastighed og opløsning.";
"conversion.guide.audio.detail" = "MP3, AAC, WAV og flere. Tilpas bithastighed eller udtræk lyd fra video.";
"conversion.guide.controls.title" = "Form kompressionen";
"conversion.guide.format.detail" = "Vælg et format, der balancerer kompatibilitet, kvalitet og filstørrelse for, hvordan filen skal bruges.";
"conversion.guide.quality.detail" = "Lavere kvalitet eller bithastighed reducerer normalt filstørrelsen. Resultatet afhænger af indholdet; tabsfri formater bliver ikke altid mindre.";
"conversion.guide.metadata.detail" = "Bevar alle skrivbare metadata, fjern kun GPS, eller fjern alt. GPS-fjernelse er standard.";
"conversion.guide.replace.title" = "Erstat originaler";
"conversion.guide.replace.detail" = "Efter konvertering skal du trykke på papirkurven på startsiden og vælge billed- eller videosamlinger. Appen gemmer først de konverterede kopier i Fotos, hvorefter iOS beder dig bekræfte sletning af de tilsvarende originaler. Kun færdige emner importeret fra Fotos understøttes; selvstændig lyd og import fra Filer understøttes ikke. Ryd alle fjerner kun arbejdskopier og deaktiverer erstatning, men sletter aldrig originaler.";
"conversion.guide.privacy.title" = "Dine originaler forbliver dine";
"conversion.guide.privacy.detail" = "Alt behandles på denne enhed. Ryd alle fjerner kun app-administrerede kopier og output, aldrig dine originaler i Fotos eller Filer.";
"conversion.guide.learn_more" = "Udforsk dette værktøj";
"conversion.guide.quality.title" = "Kvalitet og størrelse";
"conversion.guide.detail.purpose.title" = "Hvad det er til";
"conversion.guide.detail.workflow.title" = "Batch, fremskridt og resultater";
"conversion.guide.output.detail" = "Den app-administrerede outputmappe vises i værktøjet, men kan ikke vælges. Brug Del til at flytte et resultat et andet sted hen.";
"conversion.guide.image.purpose" = "JPG, PNG, HEIC og flere. Tilpas billedkvalitet og mål.";
"conversion.guide.image.imports.detail" = "Vælg flere filer eller op til 100 elementer fra Fotos. Formater afspejler denne enheds muligheder; RAW/DNG/ProRAW er kun import, og animerede billeder understøttes ikke.";
"conversion.guide.image.workflow.detail" = "Følg inspektions- og kompressionstilstande, eller annuller, mens arbejdet er i gang; afsluttede resultater forbliver. Sammenlign størrelser og del fra hvert filkort, før du rydder listen.";
"conversion.guide.image.quality.detail" = "JPG, PNG, HEIC og flere. Tilpas billedkvalitet og mål. Lavere kvalitet eller bithastighed reducerer normalt filstørrelsen. Resultatet afhænger af indholdet; tabsfri formater bliver ikke altid mindre.";
"resize.square1024" = "1024px";
"conversion.guide.image.resize.detail" = "Behold de originale dimensioner, eller dæk den længste kant til 4096, 2048 eller 1280 px for at reducere størrelsen uden at forstørre. Indstillingen 1024 × 1024 passer til hele billedet på en firkantet baggrund uden at beskære eller strække; små billeder forstørres.";
"conversion.guide.image.transparency.detail" = "JPG og BMP kan ikke gemme gennemsigtige pixels. Når du bruger begge formater, skal du udfylde gennemsigtige områder med hvid eller sort.";
"conversion.guide.video.purpose" = "MP4, MOV, M4V. Vælg codec, bithastighed og opløsning.";
"conversion.guide.video.imports.detail" = "Vælg flere MOV-, MP4- eller M4V-filer, eller vælg op til 50 videoer fra Fotos.";
"conversion.guide.video.workflow.detail" = "Videoer behandles én efter én. Følg opgavetilstande og fuldført optælling, annuller efter behov, sammenlign input- og outputstørrelser og del hvert resultat.";
"conversion.guide.video.resolution.detail" = "Sænkning af opløsning reducerer normalt filstørrelsen. H.264 tilbyder Original, 4K, 1080p, 720p og 480p; HEVC tilbyder Original, 4K og 1080p; ProRes beholder den originale opløsning.";
"conversion.guide.video.compatibility.title" = "Kombinationer og enhedsunderstøttelse";
"conversion.guide.video.compatibility.detail" = "Beholder- og opløsningsvalg indsnævres, når du har valgt et codec. Enheden og kildevideoen modtager stadig et sidste kompatibilitetstjek.";
"conversion.guide.video.codec.h264.detail" = "Bredeste kompatibilitet: MP4, MOV eller M4V; Original, 4K, 1080p, 720p eller 480p.";
"conversion.guide.video.codec.hevc.detail" = "Mere effektiv konvertering: MP4 eller MOV; Original, 4K eller 1080p. Ældre enheder og apps kan være mindre kompatible.";
"conversion.guide.video.codec.prores422.detail" = "Til højkvalitetsredigering: Kun MOV i den originale opløsning. Filer er normalt store og er ikke beregnet til pladsbesparende konvertering.";
"conversion.guide.video.codec.prores4444.detail" = "Til efterproduktion af høj kvalitet: Kun MOV, i den originale opløsning. Filer er normalt meget store og er ikke beregnet til pladsbesparende konvertering.";
"conversion.guide.audio.purpose" = "MP3, AAC, WAV og flere. Tilpas bithastighed eller udtræk lyd fra video.";
"conversion.guide.audio.imports.detail" = "Vælg lyd eller video fra Filer, eller vælg videoer fra Fotos for at udtrække deres lydspor. Lydindgange: M4A (inklusive ALAC), AAC, MP3, FLAC, WAV, AIFF/AIF og CAF. Videoindgange: MOV, MP4 og M4V.";
"conversion.guide.audio.workflow.detail" = "Følg kildetype, varighed, opgavetilstand og fuldført optælling, eller annuller, når det er nødvendigt. Sammenlign input- og outputstørrelser og del den færdige lyd.";
"conversion.guide.audio.quality.detail" = "MP3 og AAC tilbyder 96, 128, 192, 256 eller 320 kbps; standarden er 192 kbps. ALAC, WAV, AIFF og PCM CAF er tabsfri og bruger ikke en bitrate-indstilling.";
"conversion.guide.audio.m4a.title" = "M4A: container og codec";
"conversion.guide.audio.m4a.detail" = "M4A er filbeholderen, ikke konverteringsmetoden. M4A (AAC) bruger konvertering med tab til mindre, delbare filer; M4A (Apple Lossless/ALAC) bevarer kildens tilgængelige kvalitet, men er normalt større. Vælg AAC til daglig opbevaring og deling, eller ALAC, når du undgår yderligere kvalitetstab betyder mere end størrelse.";
"conversion.guide.audio.lossless.title" = "Tabsfri formater";
"conversion.guide.audio.lossless.detail" = "M4A (ALAC) og CAF ALAC bruger tabsfri kompression; WAV, AIFF og CAF PCM gemmer ukonverteret lyd og er normalt større. Disse formater bevarer den tilgængelige kvalitet i kilden og bruger ikke en bithastighedsindstilling. Konvertering af MP3 eller AAC til tabsfri kan ikke gendanne detaljer, der allerede er fjernet ved tabskonvertering.";
"conversion.guide.audio.extract.title" = "Uddrag fra video";
"conversion.guide.audio.extract.detail" = "Vælg MOV, MP4 eller M4V fra Filer eller Billeder for at læse dets tilgængelige lydspor og genkode det i det valgte format. Videoen er ikke ændret; beskyttet video eller video uden lyd kan ikke udtrækkes.";
"settings.background" = "Baggrund";
