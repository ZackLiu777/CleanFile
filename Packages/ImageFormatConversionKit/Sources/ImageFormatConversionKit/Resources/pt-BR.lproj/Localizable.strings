"conversion.guide.controls.title" = "Ajuste a conversão";
"conversion.guide.format.detail" = "Escolha um formato que equilibre compatibilidade, qualidade e tamanho para o uso desejado.";
"conversion.guide.quality.detail" = "Qualidade ou taxa de bits menores geralmente reduzem o tamanho. O resultado depende do conteúdo; formatos sem perda podem não ficar menores.";
"conversion.guide.metadata.detail" = "Preserve todos os metadados editáveis, remova apenas o GPS ou remova tudo. O padrão é remover o GPS.";
"conversion.guide.replace.title" = "Substituir originais";
"conversion.guide.replace.detail" = "Após a conversão, toque na lixeira da tela principal de conversão e selecione imagens ou vídeos. O app salva primeiro as cópias convertidas no Fotos; depois, o iOS pede confirmação para excluir os originais correspondentes. Só itens concluídos importados do Fotos podem ser substituídos. Áudio independente e arquivos importados do Arquivos não são aceitos. Limpar Tudo remove as cópias de trabalho do app e impede a substituição, mas nunca exclui os originais.";
"conversion.guide.privacy.title" = "Seus originais continuam seus";
"conversion.guide.privacy.detail" = "Tudo é processado neste dispositivo. Limpar Tudo remove apenas cópias e resultados gerenciados pelo app, nunca os originais no Fotos ou Arquivos.";
"conversion.guide.learn_more" = "Explorar esta ferramenta";
"conversion.guide.quality.title" = "Qualidade e tamanho";
"conversion.guide.detail.purpose.title" = "Para que serve";
"conversion.guide.detail.workflow.title" = "Lote, progresso e resultados";
"conversion.guide.output.detail" = "A pasta de saída gerenciada pelo app aparece na ferramenta, mas não pode ser escolhida. Use Compartilhar para mover um resultado a outro local.";
"conversion.guide.image.purpose" = "JPG, PNG, HEIC e mais. Ajuste qualidade e dimensões.";
"conversion.guide.image.imports.detail" = "Selecione vários arquivos ou até 100 itens do Fotos. Os formatos dependem deste dispositivo; RAW/DNG/ProRAW só podem ser importados, e imagens animadas não são aceitas.";
"conversion.guide.image.workflow.detail" = "Acompanhe a análise e a conversão ou cancele durante o processamento; os resultados concluídos permanecem. Compare os tamanhos e compartilhe cada arquivo antes de limpar a lista.";
"conversion.guide.image.quality.detail" = "JPG, PNG, HEIC e mais. Ajuste qualidade e dimensões. Qualidade ou taxa de bits menores geralmente reduzem o tamanho. O resultado depende do conteúdo; formatos sem perda podem não ficar menores.";
"resize.square1024" = "1024 px";
"conversion.guide.image.resize.detail" = "Mantenha as dimensões originais ou limite o lado maior a 4096, 2048 ou 1280 px para reduzir o tamanho sem ampliar. A opção 1024 × 1024 encaixa a imagem inteira em um fundo quadrado sem cortar nem esticar; imagens pequenas são ampliadas.";
"conversion.guide.image.transparency.detail" = "JPG e BMP não armazenam pixels transparentes. Nesses formatos, preencha as áreas transparentes com branco ou preto.";
"conversion.guide.video.purpose" = "MP4, MOV, M4V. Escolha codec, taxa de bits e resolução.";
"conversion.guide.video.imports.detail" = "Selecione vários arquivos MOV, MP4 ou M4V, ou até 50 vídeos do Fotos.";
"conversion.guide.video.workflow.detail" = "Os vídeos são processados um por vez. Acompanhe os estados e a quantidade concluída, cancele se necessário, compare os tamanhos e compartilhe cada resultado.";
"conversion.guide.video.resolution.detail" = "Reduzir a resolução geralmente diminui o arquivo. H.264 oferece Original, 4K, 1080p, 720p e 480p; HEVC oferece Original, 4K e 1080p; ProRes mantém a resolução original.";
"conversion.guide.video.compatibility.title" = "Combinações e compatibilidade";
"conversion.guide.video.compatibility.detail" = "As opções de formato e resolução são limitadas após a escolha do codec. O dispositivo e o vídeo de origem ainda passam por uma verificação final de compatibilidade.";
"conversion.guide.video.codec.h264.detail" = "Maior compatibilidade: MP4, MOV ou M4V; Original, 4K, 1080p, 720p ou 480p.";
"conversion.guide.video.codec.hevc.detail" = "Conversão mais eficiente: MP4 ou MOV; Original, 4K ou 1080p. Dispositivos e apps antigos podem ter menor compatibilidade.";
"conversion.guide.video.codec.prores422.detail" = "Para edição de alta qualidade: apenas MOV, na resolução original. Os arquivos costumam ser grandes e não se destinam a economizar espaço.";
"conversion.guide.video.codec.prores4444.detail" = "Para pós-produção de alta qualidade: apenas MOV, na resolução original. Os arquivos costumam ser muito grandes e não se destinam a economizar espaço.";
"conversion.guide.audio.purpose" = "MP3, AAC, WAV e mais. Ajuste a taxa de bits ou extraia áudio de vídeos.";
"conversion.guide.audio.imports.detail" = "Selecione áudio ou vídeo do Arquivos, ou vídeos do Fotos para extrair o áudio. Entradas de áudio: M4A (incluindo ALAC), AAC, MP3, FLAC, WAV, AIFF/AIF e CAF. Entradas de vídeo: MOV, MP4 e M4V.";
"conversion.guide.audio.workflow.detail" = "Acompanhe o tipo de origem, a duração, o estado e a quantidade concluída, ou cancele. Compare os tamanhos e compartilhe o áudio final.";
"conversion.guide.audio.quality.detail" = "MP3 e AAC oferecem 96, 128, 192, 256 ou 320 kbps; o padrão é 192 kbps. ALAC, WAV, AIFF e CAF PCM não têm perdas nem ajuste de taxa de bits.";
"conversion.guide.audio.m4a.title" = "M4A: formato e codec";
"conversion.guide.audio.m4a.detail" = "M4A é o formato do arquivo, não o método de conversão. M4A (AAC) usa conversão com perdas para arquivos menores e fáceis de compartilhar; M4A (Apple Lossless/ALAC) preserva a qualidade disponível na origem, mas costuma ser maior. Escolha AAC para armazenamento e compartilhamento comuns, ou ALAC quando evitar novas perdas de qualidade importar mais que o tamanho.";
"conversion.guide.audio.lossless.title" = "Formatos sem perdas";
"conversion.guide.audio.lossless.detail" = "M4A (ALAC) e CAF ALAC usam conversão sem perdas; WAV, AIFF e CAF PCM armazenam áudio sem conversão e normalmente são maiores. Eles preservam a qualidade disponível na origem e não têm ajuste de taxa de bits. Converter MP3 ou AAC para um formato sem perdas não recupera detalhes já removidos.";
"conversion.guide.audio.extract.title" = "Extrair de vídeo";
"conversion.guide.audio.extract.detail" = "Escolha MOV, MP4 ou M4V no Arquivos ou Fotos para ler a faixa de áudio disponível e recodificá-la no formato selecionado. O vídeo não é alterado; não é possível extrair de vídeos protegidos ou sem áudio.";
