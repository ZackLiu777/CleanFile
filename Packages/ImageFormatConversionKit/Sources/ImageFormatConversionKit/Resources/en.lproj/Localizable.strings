"conversion.guide.title" = "Conversion Guide";
"conversion.guide.hero.title" = "Convert without compromise";
"conversion.guide.hero.detail" = "Three focused tools for images, video, and audio—built to work locally on this device.";
"conversion.guide.steps.title" = "Quick Start";
"conversion.guide.step.choose.title" = "Choose a tool";
"conversion.guide.step.choose.detail" = "Import images and video from Photos or Files. The Audio tool accepts audio or video from Files.";
"conversion.guide.step.adjust.title" = "Set the output";
"conversion.guide.step.adjust.detail" = "Choose a format and adjust only the options that matter to you.";
"conversion.guide.step.convert.title" = "Convert and share";
"conversion.guide.step.convert.detail" = "Follow progress, review the result, then share it wherever you need.";
"conversion.guide.home.title" = "Start with the file you have";
"conversion.guide.home.detail" = "Each tool stands on its own, so you can go straight to the job you need.";
"conversion.guide.tools.title" = "Three focused tools";
"conversion.guide.image.detail" = "Change formats, resize, tune compression, and remove location metadata before sharing.";
"conversion.guide.video.detail" = "Choose a container, codec, and resolution. Options narrow with the codec; final support depends on the device and source.";
"conversion.guide.audio.detail" = "Convert audio files—or select a video here to extract its audio track.";
"conversion.guide.controls.title" = "Shape the result";
"conversion.guide.format.detail" = "Pick the format that matches how the file will be used.";
"conversion.guide.quality.detail" = "Tune image compression, video codec and resolution, or AAC bitrate. Lossless audio does not use bitrate.";
"conversion.guide.metadata.detail" = "Preserve all writable metadata, remove GPS only, or remove everything. GPS removal is the default.";
"conversion.guide.privacy.title" = "Your originals stay yours";
"conversion.guide.privacy.detail" = "Everything is processed on this device. Clear All removes only app-managed copies and outputs, never your originals in Photos or Files.";
"conversion.guide.learn_more" = "Explore this tool";
"conversion.guide.quality.title" = "Quality and size";
"conversion.guide.detail.purpose.title" = "What it is for";
"conversion.guide.detail.workflow.title" = "Batch, progress, and results";
"conversion.guide.output.detail" = "The app-managed output folder is shown in the tool but is not selectable. Use Share to move a result somewhere else.";
"conversion.guide.image.purpose" = "Batch-convert static images by format, longest edge, and metadata. One set of options applies to the current batch without changing the originals.";
"conversion.guide.image.imports.detail" = "Select multiple files, or up to 100 items from Photos. Formats reflect this device's capabilities; RAW/DNG/ProRAW are import-only, and animated images are not supported.";
"conversion.guide.image.workflow.detail" = "Follow inspection and conversion states, or cancel while work is in progress; completed results remain. Share from each file card, then clear the current list before starting another batch.";
"conversion.guide.image.quality.detail" = "JPEG, HEIC, HEIF, and WebP support 10%–100% quality in 5% steps, with 85% as the default. Other formats do not show a quality control.";
"conversion.guide.image.resize.detail" = "Keep the original dimensions, or cap the longest edge at 4096, 2048, or 1280 px. Smaller images are never enlarged.";
"conversion.guide.image.transparency.detail" = "JPEG and BMP cannot store transparent pixels. When using either format, fill transparent areas with white or black.";
"conversion.guide.video.purpose" = "Batch-convert MOV, MP4, or M4V video by container, codec, and resolution without overwriting the originals.";
"conversion.guide.video.imports.detail" = "Select multiple MOV, MP4, or M4V files, or choose up to 50 videos from Photos.";
"conversion.guide.video.workflow.detail" = "Videos are processed one by one. Follow task states and completed count, cancel when needed, then compare input and output sizes and share each result.";
"conversion.guide.video.resolution.detail" = "H.264 offers Original, 4K, 1080p, 720p, and 480p; HEVC offers Original, 4K, and 1080p; ProRes keeps the original resolution.";
"conversion.guide.video.compatibility.title" = "Combinations and device support";
"conversion.guide.video.compatibility.detail" = "Container and resolution choices narrow after you select a codec. The device and source video still receive a final compatibility check.";
"conversion.guide.video.codec.h264.detail" = "Broadest compatibility: MP4, MOV, or M4V; Original, 4K, 1080p, 720p, or 480p.";
"conversion.guide.video.codec.hevc.detail" = "More efficient compression: MP4 or MOV; Original, 4K, or 1080p. Older devices and apps may be less compatible.";
"conversion.guide.video.codec.prores422.detail" = "For high-quality editing: MOV only, at the original resolution. Files are usually large.";
"conversion.guide.video.codec.prores4444.detail" = "For high-quality post-production: MOV only, at the original resolution. Files are usually very large.";
"conversion.guide.audio.purpose" = "Convert audio formats or create a separate audio file from a video with a usable track. The original audio and video remain unchanged.";
"conversion.guide.audio.imports.detail" = "Select multiple items from Files only. Audio: M4A, AAC, MP3, WAV, AIFF/AIF, CAF. Video: MOV, MP4, M4V. MP3 is import-only.";
"conversion.guide.audio.workflow.detail" = "Follow source type, duration, task state, and completed count, or cancel when needed. Compare input and output sizes and share the finished audio.";
"conversion.guide.audio.quality.detail" = "AAC outputs offer 96, 128, 192, or 256 kbps, with 192 kbps as the default. Higher bitrates usually retain more detail and create larger files.";
"conversion.guide.audio.lossless.title" = "Lossless output";
"conversion.guide.audio.lossless.detail" = "M4A (ALAC), WAV, AIFF, CAF PCM, and CAF ALAC do not use the bitrate setting. They preserve the audio quality available in the source.";
"conversion.guide.audio.extract.title" = "Extract from video";
"conversion.guide.audio.extract.detail" = "Choose MOV, MP4, or M4V to read its available audio track and re-encode it in the selected format. The video is not changed; protected video or video without audio cannot be extracted.";
