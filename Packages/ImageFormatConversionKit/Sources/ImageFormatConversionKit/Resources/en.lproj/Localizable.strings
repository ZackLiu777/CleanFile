"conversion.guide.image.detail" = "JPG, PNG, HEIC and more. Adjust image quality and dimensions.";
"conversion.guide.video.detail" = "MP4, MOV, M4V. Choose codec, bitrate, and resolution.";
"conversion.guide.audio.detail" = "MP3, AAC, WAV and more. Adjust bitrate or extract audio from video.";
"conversion.guide.controls.title" = "Shape the conversion";
"conversion.guide.format.detail" = "Pick a format that balances compatibility, quality, and file size for how the file will be used.";
"conversion.guide.quality.detail" = "Lower quality or bitrate usually reduces file size. The result depends on the media; lossless formats may not become smaller.";
"conversion.guide.metadata.detail" = "Preserve all writable metadata, remove GPS only, or remove everything. GPS removal is the default.";
"conversion.guide.replace.title" = "Replace originals";
"conversion.guide.replace.detail" = "After conversion, tap the trash button on the conversion home screen and select image or video collections. The app saves converted copies to Photos first, then iOS asks you to confirm deleting the matching originals. Only completed items imported from Photos are eligible; standalone audio and Files imports are not supported. Clear All removes the app’s working copies and makes replacement unavailable, but never deletes originals.";
"conversion.guide.privacy.title" = "Your originals stay yours";
"conversion.guide.privacy.detail" = "Everything is processed on this device. Clear All removes only app-managed copies and outputs, never your originals in Photos or Files.";
"conversion.guide.learn_more" = "Explore this tool";
"conversion.guide.quality.title" = "Quality and size";
"conversion.guide.detail.purpose.title" = "What it is for";
"conversion.guide.detail.workflow.title" = "Batch, progress, and results";
"conversion.guide.output.detail" = "The app-managed output folder is shown in the tool but is not selectable. Use Share to move a result somewhere else.";
"conversion.guide.image.purpose" = "JPG, PNG, HEIC and more. Adjust image quality and dimensions.";
"conversion.guide.image.imports.detail" = "Select multiple files, or up to 100 items from Photos. Formats reflect this device's capabilities; RAW/DNG/ProRAW are import-only, and animated images are not supported.";
"conversion.guide.image.workflow.detail" = "Follow inspection and conversion states, or cancel while work is in progress; completed results remain. Compare sizes and share from each file card before clearing the list.";
"conversion.guide.image.quality.detail" = "JPG, PNG, HEIC and more. Adjust image quality and dimensions. Lower quality or bitrate usually reduces file size. The result depends on the media; lossless formats may not become smaller.";
"resize.square1024" = "1024px";
"conversion.guide.image.resize.detail" = "Keep the original dimensions, or cap the longest edge at 4096, 2048, or 1280 px to reduce size without enlarging. The 1024 × 1024 option fits the whole image onto a square background without cropping or stretching; small images are enlarged.";
"conversion.guide.image.transparency.detail" = "JPG and BMP cannot store transparent pixels. When using either format, fill transparent areas with white or black.";
"conversion.guide.video.purpose" = "MP4, MOV, M4V. Choose codec, bitrate, and resolution.";
"conversion.guide.video.imports.detail" = "Select multiple MOV, MP4, or M4V files, or choose up to 50 videos from Photos.";
"conversion.guide.video.workflow.detail" = "Videos are processed one by one. Follow task states and completed count, cancel when needed, then compare input and output sizes and share each result.";
"conversion.guide.video.resolution.detail" = "Lowering resolution usually reduces file size. H.264 offers Original, 4K, 1080p, 720p, and 480p; HEVC offers Original, 4K, and 1080p; ProRes keeps the original resolution.";
"conversion.guide.video.compatibility.title" = "Combinations and device support";
"conversion.guide.video.compatibility.detail" = "Container and resolution choices narrow after you select a codec. The device and source video still receive a final compatibility check.";
"conversion.guide.video.codec.h264.detail" = "Broadest compatibility: MP4, MOV, or M4V; Original, 4K, 1080p, 720p, or 480p.";
"conversion.guide.video.codec.hevc.detail" = "More efficient conversion: MP4 or MOV; Original, 4K, or 1080p. Older devices and apps may be less compatible.";
"conversion.guide.video.codec.prores422.detail" = "For high-quality editing: MOV only, at the original resolution. Files are usually large and are not intended for space-saving conversion.";
"conversion.guide.video.codec.prores4444.detail" = "For high-quality post-production: MOV only, at the original resolution. Files are usually very large and are not intended for space-saving conversion.";
"conversion.guide.audio.purpose" = "MP3, AAC, WAV and more. Adjust bitrate or extract audio from video.";
"conversion.guide.audio.imports.detail" = "Select audio or video from Files, or select videos from Photos to extract their audio tracks. Audio inputs: M4A (including ALAC), AAC, MP3, FLAC, WAV, AIFF/AIF, and CAF. Video inputs: MOV, MP4, and M4V.";
"conversion.guide.audio.workflow.detail" = "Follow source type, duration, task state, and completed count, or cancel when needed. Compare input and output sizes and share the finished audio.";
"conversion.guide.audio.quality.detail" = "MP3 and AAC offer 96, 128, 192, 256, or 320 kbps; the default is 192 kbps. ALAC, WAV, AIFF, and PCM CAF are lossless and do not use a bitrate setting.";
"conversion.guide.audio.m4a.title" = "M4A: container and codec";
"conversion.guide.audio.m4a.detail" = "M4A is the file container, not the conversion method. M4A (AAC) uses lossy conversion for smaller, shareable files; M4A (Apple Lossless/ALAC) preserves the source’s available quality but is usually larger. Choose AAC for everyday storage and sharing, or ALAC when avoiding further quality loss matters more than size.";
"conversion.guide.audio.lossless.title" = "Lossless formats";
"conversion.guide.audio.lossless.detail" = "M4A (ALAC) and CAF ALAC use lossless conversion; WAV, AIFF, and CAF PCM store unconverted audio and are usually larger. These formats preserve the quality available in the source and do not use a bitrate setting. Converting MP3 or AAC to lossless cannot restore detail already removed by lossy conversion.";
"conversion.guide.audio.extract.title" = "Extract from video";
"conversion.guide.audio.extract.detail" = "Choose MOV, MP4, or M4V from Files or Photos to read its available audio track and re-encode it in the selected format. The video is not changed; protected video or video without audio cannot be extracted.";
