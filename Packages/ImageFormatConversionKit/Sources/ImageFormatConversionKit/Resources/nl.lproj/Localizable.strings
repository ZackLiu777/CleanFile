"conversion.guide.hero.title" = "Comprimeer media, bespaar ruimte";
"conversion.guide.hero.detail" = "Comprimeer afbeeldingen, video en audio lokaal op dit apparaat zonder de originelen te wijzigen.";
"conversion.guide.steps.title" = "Snel beginnen";
"conversion.guide.step.choose.title" = "Kies een mediatype";
"conversion.guide.step.choose.detail" = "Importeer afbeeldingen en video uit foto's of bestanden. De Audio-tool accepteert audio of video van Bestanden.";
"conversion.guide.step.adjust.title" = "Pas de compressie aan";
"conversion.guide.step.adjust.detail" = "Kies een formaat en pas de kwaliteit, resolutie, bitrate of metadata indien nodig aan.";
"conversion.guide.step.convert.title" = "Comprimeren en delen";
"conversion.guide.step.convert.detail" = "Volg de voortgang van de compressie, bekijk het resultaat en deel het waar u maar wilt.";
"conversion.guide.home.title" = "Begin met het bestand dat u wilt verkleinen";
"conversion.guide.home.detail" = "Elk gereedschap staat op zichzelf, zodat u direct aan de slag kunt met de klus die u nodig heeft.";
"conversion.guide.tools.title" = "Drie mediacompressietools";
"conversion.guide.image.detail" = "Comprimeer afbeeldingen, pas het uitvoerformaat en de grootte aan en verwijder locatiemetadata voordat u deze deelt.";
"conversion.guide.video.detail" = "Comprimeer video door een container, codec en resolutie te kiezen. De uiteindelijke ondersteuning is afhankelijk van het apparaat en de bron.";
"conversion.guide.audio.detail" = "Comprimeer audiobestanden, of selecteer hier een video om de audiotrack te extraheren en te comprimeren.";
"conversion.guide.controls.title" = "Vorm de compressie";
"conversion.guide.format.detail" = "Kies een indeling waarin compatibiliteit, kwaliteit en bestandsgrootte in balans zijn voor de manier waarop het bestand zal worden gebruikt.";
"conversion.guide.quality.detail" = "Gebruik beeldkwaliteit, videocodec en resolutie, of AAC-bitsnelheid om de grootte te verkleinen. Lossless audioformaten behouden de kwaliteit, maar verkleinen mogelijk niet de grootte.";
"conversion.guide.metadata.detail" = "Bewaar alle beschrijfbare metagegevens, verwijder alleen GPS of verwijder alles. GPS-verwijdering is de standaardinstelling.";
"conversion.guide.replace.title" = "Originelen vervangen";
"conversion.guide.replace.detail" = "Tik na het comprimeren op de prullenmand op het beginscherm en selecteer afbeeldings- of videoverzamelingen. De app bewaart eerst de gecomprimeerde kopieën in Foto’s; daarna vraagt iOS om het verwijderen van de bijbehorende originelen te bevestigen. Alleen voltooide items uit Foto’s komen in aanmerking; losse audio en import uit Bestanden worden niet ondersteund. Alles wissen verwijdert alleen werkkopieën en schakelt vervangen uit, maar verwijdert nooit originelen.";
"conversion.guide.privacy.title" = "Uw originelen blijven van u";
"conversion.guide.privacy.detail" = "Op dit apparaat wordt alles verwerkt. Alles wissen verwijdert alleen door de app beheerde kopieën en uitvoer, nooit uw originelen in Foto's of Bestanden.";
"conversion.guide.learn_more" = "Ontdek dit hulpmiddel";
"conversion.guide.quality.title" = "Kwaliteit en maat";
"conversion.guide.detail.purpose.title" = "Waar het voor is";
"conversion.guide.detail.workflow.title" = "Batch, voortgang en resultaten";
"conversion.guide.output.detail" = "De door de app beheerde uitvoermap wordt in de tool weergegeven, maar kan niet worden geselecteerd. Gebruik Delen om een ​​resultaat ergens anders te verplaatsen.";
"conversion.guide.image.purpose" = "Comprimeer statische afbeeldingen in batches op formaat, kwaliteit, langste rand en metagegevens. Eén set opties is van toepassing op de huidige batch zonder de originelen te wijzigen.";
"conversion.guide.image.imports.detail" = "Selecteer meerdere bestanden of maximaal 100 items uit Foto's. Formaten weerspiegelen de mogelijkheden van dit apparaat; RAW/DNG/ProRAW kunnen alleen worden geïmporteerd en geanimeerde afbeeldingen worden niet ondersteund.";
"conversion.guide.image.workflow.detail" = "Volg inspectie- en compressiestatussen, of annuleer terwijl het werk aan de gang is; voltooide resultaten blijven staan. Vergelijk formaten en deel van elke bestandskaart voordat u de lijst wist.";
"conversion.guide.image.quality.detail" = "JPG, HEIC, HEIF en WebP ondersteunen een kwaliteit van 10%–100% in stappen van 5%, met 85% als standaard. Een lagere kwaliteit zorgt meestal voor kleinere bestanden met meer zichtbaar verlies; andere formaten vertonen geen kwaliteitscontrole.";
"resize.square1024" = "1024px";
"conversion.guide.image.resize.detail" = "Behoud de oorspronkelijke afmetingen of sluit de langste rand af op 4096, 2048 of 1280 px om de grootte te verkleinen zonder te vergroten. Met de optie 1024 × 1024 wordt de hele afbeelding op een vierkante achtergrond geplaatst, zonder bijsnijden of uitrekken; kleine afbeeldingen worden vergroot.";
"conversion.guide.image.transparency.detail" = "JPG en BMP kunnen geen transparante pixels opslaan. Wanneer u een van beide formaten gebruikt, vult u transparante gebieden met wit of zwart.";
"conversion.guide.video.purpose" = "Comprimeer MOV-, MP4- of M4V-video in batch op basis van container, codec en resolutie zonder de originelen te overschrijven.";
"conversion.guide.video.imports.detail" = "Selecteer meerdere MOV-, MP4- of M4V-bestanden, of kies maximaal 50 video's uit Foto's.";
"conversion.guide.video.workflow.detail" = "Video's worden één voor één verwerkt. Volg de taakstatus en het voltooide aantal, annuleer indien nodig, vergelijk vervolgens de invoer- en uitvoergroottes en deel elk resultaat.";
"conversion.guide.video.resolution.detail" = "Als u de resolutie verlaagt, wordt de bestandsgrootte doorgaans kleiner. H.264 biedt origineel, 4K, 1080p, 720p en 480p; HEVC biedt origineel, 4K en 1080p; ProRes behoudt de oorspronkelijke resolutie.";
"conversion.guide.video.compatibility.title" = "Combinaties en apparaatondersteuning";
"conversion.guide.video.compatibility.detail" = "De keuzes voor containers en resoluties worden kleiner nadat u een codec hebt geselecteerd. Het apparaat en de bronvideo ondergaan nog een laatste compatibiliteitscontrole.";
"conversion.guide.video.codec.h264.detail" = "Breedste compatibiliteit: MP4, MOV of M4V; Origineel, 4K, 1080p, 720p of 480p.";
"conversion.guide.video.codec.hevc.detail" = "Efficiëntere compressie: MP4 of MOV; Origineel, 4K of 1080p. Oudere apparaten en apps zijn mogelijk minder compatibel.";
"conversion.guide.video.codec.prores422.detail" = "Voor hoogwaardige bewerking: alleen MOV, met de originele resolutie. Bestanden zijn doorgaans groot en niet bedoeld voor ruimtebesparende compressie.";
"conversion.guide.video.codec.prores4444.detail" = "Voor postproductie van hoge kwaliteit: alleen MOV, met de originele resolutie. Bestanden zijn doorgaans erg groot en niet bedoeld voor ruimtebesparende compressie.";
"conversion.guide.audio.purpose" = "Comprimeer audio of maak een apart gecomprimeerd audiobestand van een video met een bruikbaar nummer. De originele audio en video blijven ongewijzigd.";
"conversion.guide.audio.imports.detail" = "Selecteer audio of video uit Bestanden, of selecteer video's uit Foto's om de audiotracks eruit te halen. Audio-ingangen: M4A (inclusief ALAC), AAC, MP3, FLAC, WAV, AIFF/AIF en CAF. Video-ingangen: MOV, MP4 en M4V.";
"conversion.guide.audio.workflow.detail" = "Volg het brontype, de duur, de taakstatus en het voltooide aantal, of annuleer indien nodig. Vergelijk invoer- en uitvoerformaten en deel de voltooide audio.";
"conversion.guide.audio.quality.detail" = "MP3 en AAC bieden 96, 128, 192, 256 of 320 kbps; de standaardwaarde is 192 kbps. ALAC, WAV, AIFF en PCM CAF zijn verliesvrij en gebruiken geen bitrate-instelling.";
"conversion.guide.audio.m4a.title" = "M4A: container en codec";
"conversion.guide.audio.m4a.detail" = "M4A is de bestandscontainer, niet de compressiemethode. M4A (AAC) gebruikt compressie met verlies voor kleinere, deelbare bestanden; M4A (Apple Lossless/ALAC) behoudt de beschikbare kwaliteit van de bron, maar is meestal groter. Kies AAC voor dagelijkse opslag en delen, of ALAC als het voorkomen van verder kwaliteitsverlies belangrijker is dan de grootte.";
"conversion.guide.audio.lossless.title" = "Verliesloze formaten";
"conversion.guide.audio.lossless.detail" = "M4A (ALAC) en CAF ALAC gebruiken verliesloze compressie; WAV, AIFF en CAF PCM slaan ongecomprimeerde audio op en zijn meestal groter. Deze formaten behouden de kwaliteit die beschikbaar is in de bron en gebruiken geen bitrate-instelling. Het converteren van MP3 of AAC naar lossless kan geen details herstellen die al zijn verwijderd door compressie met verlies.";
"conversion.guide.audio.extract.title" = "Uittreksel uit video";
"conversion.guide.audio.extract.detail" = "Kies MOV, MP4 of M4V uit Bestanden of Foto's om de beschikbare audiotrack te lezen en deze opnieuw te coderen in het geselecteerde formaat. De video is niet gewijzigd; beveiligde video of video zonder audio kan niet worden geëxtraheerd.";
"settings.background" = "Achtergrond";
"color.transparent" = "Transparant";
"settings.background.detail" = "Geldt voor transparante pixels en vierkante opvulling; de achtergrond van de afbeelding wordt niet verwijderd. Transparantie is beschikbaar voor PNG en TIFF. Andere formaten zetten de transparantie terug naar wit.";
