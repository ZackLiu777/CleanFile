"conversion.guide.step.convert.title" = "Kompresuj i udostępnij";
"conversion.guide.step.convert.detail" = "Śledź postęp kompresji, sprawdź wynik i udostępnij go tam, gdzie potrzebujesz.";
"conversion.guide.home.title" = "Zacznij od pliku, który chcesz zmniejszyć";
"conversion.guide.home.detail" = "Każde narzędzie działa niezależnie, więc możesz od razu przejść do potrzebnego zadania.";
"conversion.guide.tools.title" = "Trzy narzędzia do kompresji";
"conversion.guide.image.detail" = "Kompresuj obrazy, dostosuj format i rozmiar oraz usuń dane lokalizacji przed udostępnieniem.";
"conversion.guide.video.detail" = "Kompresuj wideo, wybierając kontener, kodek i rozdzielczość. Dostępność zależy od urządzenia i źródła.";
"conversion.guide.audio.detail" = "Kompresuj pliki audio lub wybierz film, aby wyodrębnić i skompresować jego ścieżkę dźwiękową.";
"conversion.guide.controls.title" = "Dostosuj kompresję";
"conversion.guide.format.detail" = "Wybierz format łączący zgodność, jakość i rozmiar pliku odpowiednio do jego zastosowania.";
"conversion.guide.quality.detail" = "Zmniejsz rozmiar przez zmianę jakości obrazu, kodeka i rozdzielczości wideo lub szybkości AAC. Format bezstratny może nie zmniejszyć pliku.";
"conversion.guide.metadata.detail" = "Zachowaj wszystkie zapisywalne metadane, usuń tylko GPS lub usuń wszystko. Domyślnie usuwany jest GPS.";
"conversion.guide.replace.title" = "Zastąp oryginały";
"conversion.guide.replace.detail" = "Po kompresji dotknij kosza na stronie głównej i wybierz kolekcje obrazów lub filmów. Aplikacja najpierw zapisze skompresowane kopie w Zdjęciach, a następnie iOS poprosi o potwierdzenie usunięcia oryginałów. Dostępne są tylko ukończone elementy zaimportowane ze Zdjęć; osobne pliki audio i pliki z aplikacji Pliki nie są obsługiwane. Wyczyść wszystko usuwa kopie robocze aplikacji i wyłącza zastępowanie, ale nigdy nie usuwa oryginałów.";
"conversion.guide.privacy.title" = "Oryginały pozostają Twoje";
"conversion.guide.privacy.detail" = "Całe przetwarzanie odbywa się na urządzeniu. Wyczyść wszystko usuwa tylko kopie i wyniki aplikacji, nigdy oryginały w Zdjęciach lub Plikach.";
"conversion.guide.learn_more" = "Poznaj narzędzie";
"conversion.guide.quality.title" = "Jakość i rozmiar";
"conversion.guide.detail.purpose.title" = "Do czego służy";
"conversion.guide.detail.workflow.title" = "Partie, postęp i wyniki";
"conversion.guide.output.detail" = "Folder wynikowy aplikacji jest wyświetlany w narzędziu, ale nie można go wybrać. Użyj Udostępnij, aby przenieść wynik gdzie indziej.";
"conversion.guide.image.purpose" = "Kompresuj partiami nieruchome obrazy, wybierając format, jakość, najdłuższy bok i metadane. Jeden zestaw opcji dotyczy całej partii bez zmiany oryginałów.";
"conversion.guide.image.imports.detail" = "Wybierz wiele plików lub do 100 elementów ze Zdjęć. Formaty zależą od urządzenia; RAW/DNG/ProRAW służą tylko do importu, a obrazy animowane nie są obsługiwane.";
"conversion.guide.image.workflow.detail" = "Śledź sprawdzanie i kompresję albo anuluj trwające zadanie; ukończone wyniki zostaną zachowane. Porównaj rozmiary i udostępnij pliki przed wyczyszczeniem listy.";
"conversion.guide.image.quality.detail" = "JPG, HEIC, HEIF i WebP obsługują jakość 10%–100% co 5%; domyślnie 85%. Niższa jakość zwykle oznacza mniejsze pliki i widoczną utratę szczegółów. Inne formaty nie mają tego ustawienia.";
"resize.square1024" = "1024px";
"conversion.guide.image.resize.detail" = "Zachowaj oryginalne wymiary lub ogranicz najdłuższy bok do 4096, 2048 albo 1280 px. Opcja 1024 × 1024 umieszcza cały obraz na kwadratowym tle bez przycinania; małe obrazy zostaną powiększone.";
"conversion.guide.image.transparency.detail" = "JPG i BMP nie obsługują przezroczystości. Wypełnij przezroczyste obszary bielą lub czernią.";
"conversion.guide.video.purpose" = "Kompresuj partiami filmy MOV, MP4 lub M4V, wybierając kontener, kodek i rozdzielczość, bez nadpisywania oryginałów.";
"conversion.guide.video.imports.detail" = "Wybierz wiele plików MOV, MP4 lub M4V albo do 50 filmów ze Zdjęć.";
"conversion.guide.video.workflow.detail" = "Filmy są przetwarzane po kolei. Śledź stan i liczbę ukończonych zadań, anuluj w razie potrzeby, porównaj rozmiary i udostępnij wyniki.";
"conversion.guide.video.resolution.detail" = "Obniżenie rozdzielczości zwykle zmniejsza plik. H.264 oferuje oryginalną, 4K, 1080p, 720p i 480p; HEVC oryginalną, 4K i 1080p; ProRes zachowuje oryginalną.";
"conversion.guide.video.compatibility.title" = "Połączenia ustawień i zgodność urządzenia";
"conversion.guide.video.compatibility.detail" = "Wybór kodeka zawęża dostępne kontenery i rozdzielczości. Urządzenie i film źródłowy przechodzą jeszcze końcową kontrolę zgodności.";
"conversion.guide.video.codec.h264.detail" = "Najszersza zgodność: MP4, MOV lub M4V; oryginalna, 4K, 1080p, 720p lub 480p.";
"conversion.guide.video.codec.hevc.detail" = "Wydajniejsza kompresja: MP4 lub MOV; oryginalna, 4K lub 1080p. Starsze urządzenia i aplikacje mogą nie obsługiwać tego formatu.";
"conversion.guide.video.codec.prores422.detail" = "Do edycji wysokiej jakości: tylko MOV i oryginalna rozdzielczość. Pliki są zwykle duże i nie służą do oszczędzania miejsca.";
"conversion.guide.video.codec.prores4444.detail" = "Do postprodukcji wysokiej jakości: tylko MOV i oryginalna rozdzielczość. Pliki są zwykle bardzo duże.";
"conversion.guide.audio.purpose" = "Kompresuj dźwięk lub utwórz osobny plik audio z filmu zawierającego ścieżkę dźwiękową. Oryginały pozostają bez zmian.";
"conversion.guide.audio.imports.detail" = "Wybierz dźwięk lub film z Plików albo filmy ze Zdjęć. Obsługiwane audio: M4A (w tym ALAC), AAC, MP3, FLAC, WAV, AIFF/AIF i CAF. Wideo: MOV, MP4 i M4V.";
"conversion.guide.audio.workflow.detail" = "Śledź typ źródła, czas trwania, stan i liczbę ukończonych zadań lub anuluj w razie potrzeby. Porównaj rozmiary i udostępnij wynik.";
"conversion.guide.audio.quality.detail" = "MP3 i AAC oferują 96, 128, 192, 256 lub 320 kb/s; domyślnie 192 kb/s. ALAC, WAV, AIFF i PCM CAF są bezstratne i nie mają ustawienia szybkości transmisji.";
"conversion.guide.audio.m4a.title" = "M4A: kontener i kodek";
"conversion.guide.audio.m4a.detail" = "M4A jest kontenerem pliku, a nie metodą kompresji. M4A (AAC) używa kompresji stratnej dla mniejszych plików; M4A (ALAC) zachowuje dostępną jakość, ale zwykle zajmuje więcej miejsca. Wybierz AAC do codziennego użytku, a ALAC, gdy ważniejsze jest uniknięcie dalszej utraty jakości.";
"conversion.guide.audio.lossless.title" = "Formaty bezstratne";
"conversion.guide.audio.lossless.detail" = "M4A (ALAC) i CAF ALAC stosują kompresję bezstratną; WAV, AIFF i CAF PCM przechowują nieskompresowany dźwięk i są zwykle większe. Zachowują dostępną jakość źródła i nie używają ustawienia szybkości transmisji. Konwersja MP3 lub AAC na format bezstratny nie przywróci utraconych szczegółów.";
"conversion.guide.audio.extract.title" = "Wyodrębnij z filmu";
"conversion.guide.audio.extract.detail" = "Wybierz MOV, MP4 lub M4V z Plików albo Zdjęć, aby odczytać ścieżkę audio i zakodować ją w wybranym formacie. Film pozostaje bez zmian; nie można wyodrębnić dźwięku z filmu chronionego lub bez ścieżki audio.";
"settings.background" = "Tło";
"color.transparent" = "Przezroczyste";
"settings.background.detail" = "Dotyczy przezroczystych pikseli i kwadratowych marginesów; nie usuwa tła obrazu. Przezroczystość jest dostępna dla PNG i TIFF. Inne formaty ustawiają białe tło.";
