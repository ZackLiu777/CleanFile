"conversion.guide.hero.title" = "Kompresuj multimedia, oszczędzaj miejsce";
"conversion.guide.hero.detail" = "Kompresuj obrazy, filmy i dźwięk lokalnie na tym urządzeniu bez zmiany oryginałów.";
"conversion.guide.steps.title" = "Szybki start";
"conversion.guide.step.choose.title" = "Wybierz typ multimediów";
"conversion.guide.step.choose.detail" = "Importuj obrazy i filmy ze Zdjęć lub Plików. Narzędzie Audio przyjmuje pliki audio i wideo z Plików.";
"conversion.guide.step.adjust.title" = "Dostosuj kompresję";
