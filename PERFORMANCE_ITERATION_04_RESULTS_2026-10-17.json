    "CleanMyIPhone/Features/Media/Models/MediaSizeRequestQueue.swift": "797cb01cfab0c76af2ac13310b866ff9fd2cab8b0a9a9def960d4c0b79d9957b",
    "Packages/ImageFormatConversionKit/Sources/ImageFormatConversionKit/Engines/BatchResultOrderingCandidate.swift": "119c20c455d10b4a1cafff6cd92e332845c0c21c630327ed98ccc012315b4023",
    "CleanMyIPhoneTests/PerformanceIteration04Tests.swift": "e52409396df75812f20f77d6e4e0106528e66bf397f944bfe08e91d32086f75b"
  },
  "initial_sources": {
    "queue": "import Foundation\n\n/// FIFO for PhotoKit identifier requests. All mutation remains owned by the ViewModel.\nnonisolated struct MediaSizeRequestQueue {\n    private var storage: [String] = []\n    private var head = 0\n\n    var count: Int { storage.count - head }\n    var isEmpty: Bool { count == 0 }\n\n    mutating func append(_ identifier: String) { storage.append(identifier) }\n\n    mutating func popFirst() -> String? {\n        guard head < storage.count else { return nil }\n        // Short queues keep the original array path; large queues avoid repeated tail copies.\n        if head == 0, storage.count <= 32 { return storage.removeFirst() }\n        let identifier = storage[head]\n        storage[head] = \"\"\n        head += 1\n        if head == storage.count {\n            storage.removeAll(keepingCapacity: true)\n            head = 0\n        } else if head >= 1_024, head >= storage.count - head {\n            storage.removeFirst(head)\n            head = 0\n        }\n        return identifier\n    }\n\n    mutating func removeAll() {\n        storage.removeAll()\n        head = 0\n    }\n}\n\n/// Both timed paths live in the same module and include enqueue/dequeue work.\nnonisolated enum MediaSizeRequestQueueComparison {\n    static func original(_ identifiers: [String], cycles: Int) -> Int {\n        var checksum = 0\n        for _ in 0..<cycles {\n            var queue: [String] = []\n            for identifier in identifiers { queue.append(identifier) }\n            while !queue.isEmpty { checksum &+= queue.removeFirst().utf8.count }\n        }\n        return checksum\n    }\n\n    static func proposed(_ identifiers: [String], cycles: Int) -> Int {\n        var checksum = 0\n        for _ in 0..<cycles {\n            var queue = MediaSizeRequestQueue()\n            for identifier in identifiers { queue.append(identifier) }\n            while let identifier = queue.popFirst() { checksum &+= identifier.utf8.count }\n        }\n        return checksum\n    }\n}\n",
    "ordering": "/// Candidate only. Request indexes are unique and in 0..<total, as guaranteed by the batch loop.\nenum BatchResultOrderingCandidate {\n    static func original<Value>(_ values: [(Int, Value)]) -> [Value] {\n        values.sorted { $0.0 < $1.0 }.map(\\.1)\n    }\n\n    static func proposed<Value>(_ values: [(Int, Value)], total: Int) -> [Value] {\n        guard values.count > 32, total >= values.count,\n              total / 4 <= values.count else { return original(values) }\n        var positions = Array(repeating: -1, count: total)\n        for (position, pair) in values.enumerated() {\n            guard positions.indices.contains(pair.0), positions[pair.0] == -1 else {\n                return original(values)\n            }\n            positions[pair.0] = position\n        }\n        var result: [Value] = []\n        result.reserveCapacity(values.count)\n        for position in positions where position >= 0 { result.append(values[position].1) }\n        return result\n    }\n}\n"
